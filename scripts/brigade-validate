#!/usr/bin/env node
// brigade-validate — zero-token conformance checks for brigade artifacts.
//
// Validates the typed artifacts a dish produces (plan, briefs, reports,
// verdicts, plan checks, analyst reports) against the registry in SCHEMAS.md:
// envelope keys, enum values, plan-item DAG sanity, and body length budgets.
// The Planner runs this instead of re-reading artifacts with model tokens, and
// a clean pass is part of what makes runs reproducible: state lives in
// frontmatter that machines (and the next session) can trust.
//
// Usage:
//   brigade-validate                 # validate every dish under .brigade/
//   brigade-validate <path.md>...    # validate specific artifact files
//   brigade-validate --json          # machine-readable results
//
// Exit codes: 0 = all conforming, 1 = violations found, 2 = usage/IO error.
// Writing checks on a plan's packets (`writing: <preset>`) only ever add warnings.
import fs from 'node:fs'
import path from 'node:path'
import { execFileSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'

const STATUSES = ['todo', 'dispatched', 'in_review', 'rework', 'done', 'blocked']
const SEVERITIES = ['blocking', 'high', 'medium', 'low']
const ATTEMPT_TRIGGERS = ['initial', 'fail-retry', 'escalation']
const TIERS = ['three-star', 'two-star', 'one-star']
const CONTEXT_TIERS = ['bare', 'documented', 'tracked']
const RESEARCH_BUDGETS = { light: 150, medium: 250, heavy: 400 }
const ANALYST_BUDGETS = { standard: 120, intensive: 200 }

// Per-type contract: required frontmatter keys, enum checks, body line budget.
const TYPES = {
  plan: { keys: ['ticket', 'source', 'items'], budget: null },
  brief: { keys: ['question', 'confidence', 'sources'], budget: 150 },
  report: { keys: ['status', 'attempt', 'branch', 'files_changed', 'commands'], budget: 120 },
  verdict: { keys: ['verdict', 'attempt_reviewed', 'reran_gate', 'findings'], budget: 150 },
  plan_check: { keys: ['blind_sketch_first'], budget: 150 },
  analyst: { keys: ['items_total', 'proposals'], budget: null }, // budget comes from mode
  research: { keys: ['item', 'depth', 'confidence', 'sources'], budget: null }, // budget comes from depth
  design_swag: { keys: ['ticket', 'source', 'readiness', 'sources'], budget: 140 },
  ledger: { keys: ['dish', 'item', 'attempt', 'updated'], budget: 80 },
  review_report: { keys: ['input', 'context_tier', 'tier', 'findings'], budget: 250 },
}
const ENVELOPE = ['doc', 'schema'] // hard-required; role/model/created are warnings
const RECOMMENDED = ['role', 'model', 'created']

function splitFrontmatter(text, file) {
  const lines = text.split('\n')
  if (lines[0] !== '---') return { error: `${file}: no frontmatter (must start with ---)` }
  const end = lines.indexOf('---', 1)
  if (end < 0) return { error: `${file}: unterminated frontmatter` }
  return { fm: lines.slice(1, end), body: lines.slice(end + 1) }
}

function topLevelKeys(fm) {
  const keys = new Set()
  for (const line of fm) {
    const m = line.match(/^([a-z_]+):/)
    if (m) keys.add(m[1])
  }
  return keys
}

function fmValue(fm, key) {
  const line = fm.find((l) => l.startsWith(`${key}:`))
  return line ? line.slice(key.length + 1).trim() : null
}

// Splits a top-level list key's block into one string per `- ` entry, joining wrapped
// lines — inline objects may span lines and block-style entries nest their fields on
// following lines. Field extraction then works per entry.
function listEntries(fm, listKey) {
  const entries = []
  let inList = false
  let current = []
  const flush = () => {
    if (current.length > 0) entries.push(current.join(' '))
    current = []
  }
  for (const line of fm) {
    if (/^[a-z_]+:/.test(line)) {
      flush()
      inList = line.startsWith(`${listKey}:`)
      continue
    }
    if (!inList) continue
    if (/^\s*- /.test(line)) {
      flush()
      current = [line]
    } else if (current.length > 0) {
      current.push(line)
    }
  }
  flush()
  return entries
}

// Pulls one `field: value` per list entry (block or inline style, wrapped lines included).
// Values are single tokens or bracketed lists; the lookahead stops before the next key so
// a wrapped entry's following fields are never misread as part of the value.
function nestedFieldValues(fm, listKey, field) {
  const values = []
  const pattern = new RegExp(`(?:^|[\\s{,])${field}:\\s*(\\[[^\\]]*\\]|"[^"]*"|[^,}\\s]+)`)
  for (const entry of listEntries(fm, listKey)) {
    const m = entry.match(pattern)
    if (m && m[1]) values.push(m[1].trim())
  }
  return values
}

// --- writing checks on packets ----------------------------------------------
//
// A plan that says `writing: <preset>` gets its packets checked against the writing
// rules a script can check: sentence length, one instruction per step, no
// vendor-specific markup, approved terms. Plans are model-written and can be huge or
// hostile, so every scan here is one pass over each line, and every pattern has at
// most one unbounded run. Every miss is a warning; none of them can fail a plan.

const WRITING_SKIPPED = 'writing checks skipped: could not resolve writing config'
const WRITING_CONFIG_TIMEOUT_MS = 5000

// The plan's value of `writing:`, without a trailing comment or quotes.
function writingPreset(fm) {
  let value = fmValue(fm, 'writing') || ''
  const comment = value.search(/\s#/)
  if (comment >= 0) value = value.slice(0, comment)
  value = value.trim()
  if (value.length >= 2 && (value[0] === '"' || value[0] === "'") && value.at(-1) === value[0]) {
    value = value.slice(1, -1)
  }
  return value
}

// The repository a plan belongs to: the nearest folder above it holding `.brigade`,
// else its git top level, else the plan's own folder.
function planRepo(file) {
  const start = path.dirname(path.resolve(file))
  for (let cursor = start; ; ) {
    if (fs.existsSync(path.join(cursor, '.brigade'))) return cursor
    const parent = path.dirname(cursor)
    if (parent === cursor) break
    cursor = parent
  }
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], {
      cwd: start,
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim()
  } catch {
    return start
  }
}

// Asks the brigade-config next to this script for the plan's packet checks, once per
// plan. The plan's own preset is passed in, so a plan validated from a worktree or a
// subfolder still gets its preset. Returns null when the answer can't be trusted:
// the command failed, hung past the timeout, or printed something other than the
// expected shape.
function loadPacketChecks(file, preset) {
  const repo = planRepo(file)
  const sibling = path.join(path.dirname(fileURLToPath(import.meta.url)), 'brigade-config')
  let out
  try {
    out = execFileSync(process.execPath, [sibling, 'writing', '--json', '--preset', preset], {
      cwd: repo,
      // brigade-config prefers these variables over its working directory, so point
      // them at the plan's repository too.
      env: { ...process.env, BRIGADE_PROJECT_DIR: repo },
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      timeout: WRITING_CONFIG_TIMEOUT_MS,
      killSignal: 'SIGKILL',
    })
  } catch {
    return null
  }
  let packet
  try {
    packet = JSON.parse(out)?.checks?.packet
  } catch {
    return null
  }
  return packetChecks(packet)
}

// Checks the shape of `checks.packet` and compiles the approved terms. Any value of the
// wrong type means the output is not what we asked for, so nothing gets checked.
function packetChecks(raw) {
  const isObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v)
  const isLimit = (v) => Number.isInteger(v) && v >= 0
  if (!isObject(raw) || !isObject(raw.terms)) return null
  if (!isLimit(raw.maxStepWords) || !isLimit(raw.maxDescriptionWords)) return null
  if (typeof raw.oneInstructionPerStep !== 'boolean' || typeof raw.vendorNeutral !== 'boolean') return null
  const terms = []
  for (const [term, banned] of Object.entries(raw.terms)) {
    if (!Array.isArray(banned)) return null
    for (const word of banned) {
      if (typeof word !== 'string') return null
      if (word.trim() === '') continue
      // A whole word: no letter, digit or underscore right before or after it.
      const literal = word.trim().replace(/[.*+?^${}()|[\]\\/]/g, '\\$&')
      terms.push({ term, banned: word.trim(), pattern: new RegExp(`(?<![\\p{L}\\p{N}_])${literal}(?![\\p{L}\\p{N}_])`, 'iu') })
    }
  }
  return {
    maxStepWords: raw.maxStepWords,
    maxDescriptionWords: raw.maxDescriptionWords,
    oneInstructionPerStep: raw.oneInstructionPerStep,
    vendorNeutral: raw.vendorNeutral,
    terms,
  }
}

// XML-style tags, chat-template tokens, and the agent's tools named as proper nouns.
// Each alternative starts on a fixed character and has at most one run, which stops at
// the first character outside its class, so a line of 100,000 `<` stays linear.
const VENDOR_MARKUP = /<\/?[A-Za-z][\w:.-]*>|<\|[^|\n]{0,64}\|>|\[\/?INST\]|\b[Tt]he (?:Read|Grep|Bash|Edit|Write) tool\b/

const FENCE = /^\s*(`{3,}|~{3,})(.*)$/
// `- `, `* `, `+ `, `1. `, `1) `, optionally followed by a `[ ]` checkbox.
const LIST_MARKER = /^\s*(?:[-*+]|(\d{1,9})[.)])(?:\s+\[[ xX]\])?(?=\s|$)/
const JOINED_INSTRUCTIONS = [', then ', ' and then ', '; ']

// Splits a line into prose and inline code. A run of backticks opens a code span that
// the next run of the same length closes; a run with no partner is plain text. One
// forward cursor per run length keeps this a single pass even for a line of backticks.
function codeSegments(line) {
  const runs = []
  for (let i = line.indexOf('`'); i >= 0; i = line.indexOf('`', i)) {
    let end = i
    while (line[end] === '`') end++
    runs.push({ start: i, len: end - i })
    i = end
  }
  if (runs.length === 0) return [{ text: line, code: false }]
  const byLen = new Map()
  runs.forEach((run, k) => {
    if (!byLen.has(run.len)) byLen.set(run.len, { at: [], cursor: 0 })
    byLen.get(run.len).at.push(k)
  })
  const segments = []
  let pos = 0
  for (let k = 0; k < runs.length; ) {
    const same = byLen.get(runs[k].len)
    while (same.cursor < same.at.length && same.at[same.cursor] <= k) same.cursor++
    if (same.cursor >= same.at.length) {
      k++
      continue
    }
    const close = same.at[same.cursor]
    if (runs[k].start > pos) segments.push({ text: line.slice(pos, runs[k].start), code: false })
    segments.push({ text: line.slice(runs[k].start + runs[k].len, runs[close].start), code: true })
    pos = runs[close].start + runs[close].len
    k = close + 1
  }
  if (pos < line.length) segments.push({ text: line.slice(pos), code: false })
  return segments
}

// Walks every packet in a plan body and adds a warning for each writing miss.
// `firstLine` is the file line number of body[0], so messages point into the file.
function checkPackets(body, firstLine, checks, warnings) {
  let fence = null // the open fence's marker while inside fenced code
  let slug = null // the packet we are in, if any
  let section = '' // its current `### ` heading, lower-cased
  let block = null // the prose block being read for the sentence checks

  const warn = (n, message) => warnings.push(`packet ${slug} line ${n}: ${message}`)

  // A word is a whitespace-separated token with a letter or digit in it, or with inline
  // code in it; a sentence ends at . ! or ? followed by a space or the end of the line.
  const endToken = () => {
    if (block.inToken && block.tokenIsWord) {
      if (block.words === 0) block.start = block.tokenLine
      block.words++
    }
    block.inToken = false
    block.tokenIsWord = false
  }
  const endSentence = () => {
    endToken()
    if (block.limit > 0 && block.words > block.limit) {
      warn(block.start, `${block.kind} sentence has ${block.words} words (limit ${block.limit})`)
    }
    block.words = 0
    if (block.step && !block.firstDone) {
      block.firstDone = true
      const first = block.firstText.toLowerCase()
      if (JOINED_INSTRUCTIONS.some((joint) => first.includes(joint))) {
        warn(block.stepLine, 'step holds more than one instruction')
      }
    }
  }
  const endBlock = () => {
    if (block) endSentence()
    block = null
  }
  const startToken = (n) => {
    if (!block.inToken) {
      block.inToken = true
      block.tokenLine = n
    }
  }

  // Reads one line of prose into the current block.
  const readProse = (segments, n) => {
    for (let s = 0; s < segments.length; s++) {
      const { text, code } = segments[s]
      if (code) {
        startToken(n)
        block.tokenIsWord = true
        // A placeholder with no spaces, so a joint can't run across inline code.
        if (block.step && !block.firstDone) block.firstText += '\u0000'
        continue
      }
      const lastSegment = s === segments.length - 1
      for (let j = 0; j < text.length; j++) {
        const c = text[j]
        if (block.step && !block.firstDone) block.firstText += c
        if (c === ' ' || c === '\t') {
          endToken()
          continue
        }
        startToken(n)
        if (!block.tokenIsWord && /[\p{L}\p{N}]/u.test(c)) block.tokenIsWord = true
        if (c === '.' || c === '!' || c === '?') {
          const next = j + 1 < text.length ? text[j + 1] : lastSegment ? '' : '`'
          if (next === '' || next === ' ' || next === '\t') endSentence()
        }
      }
    }
    endToken()
    // A wrapped line carries on the same sentence, joined by a space.
    if (block.step && !block.firstDone) block.firstText += ' '
  }

  for (let i = 0; i < body.length; i++) {
    const line = body[i]
    const n = firstLine + i

    const fenceMatch = line.match(FENCE)
    if (fence) {
      const [, marker, rest] = fenceMatch || []
      if (marker && marker[0] === fence[0] && marker.length >= fence.length && rest.trim() === '') fence = null
      continue
    }
    if (fenceMatch) {
      endBlock()
      fence = fenceMatch[1]
      continue
    }

    if (line.startsWith('## ')) {
      endBlock()
      slug = line.startsWith('## Packet:') ? line.slice('## Packet:'.length).trim() : null
      section = ''
    }
    if (slug === null) continue

    const segments = codeSegments(line)
    const prose = segments.map((seg) => (seg.code ? seg : { text: seg.text.replace(/\*\*|__/g, ''), code: false }))

    if (checks.vendorNeutral) {
      for (const seg of prose) {
        const hit = seg.code ? null : seg.text.match(VENDOR_MARKUP)
        if (hit) {
          warn(n, `vendor-specific markup "${hit[0]}"`)
          break
        }
      }
    }
    for (const { term, banned, pattern } of checks.terms) {
      if (prose.some((seg) => !seg.code && pattern.test(seg.text))) {
        warn(n, `says "${banned}", the approved term is "${term}"`)
      }
    }

    if (/^#{1,6}\s/.test(line)) {
      endBlock()
      if (line.startsWith('### ')) section = line.slice(4).trim().toLowerCase()
      continue
    }
    if (line.trim() === '') {
      endBlock()
      continue
    }

    const kind = section === 'steps' ? 'step' : section === 'goal' || section === 'preconditions & hazards' ? 'description' : null
    if (kind === null) continue
    const limit = kind === 'step' ? checks.maxStepWords : checks.maxDescriptionWords

    // A list marker starts a new block and is not a word; a numbered one in Steps is a step.
    const marker = prose[0] && !prose[0].code ? prose[0].text.match(LIST_MARKER) : null
    if (marker) {
      endBlock()
      prose[0] = { text: prose[0].text.slice(marker[0].length), code: false }
    }
    if (!block) {
      const step = kind === 'step' && Boolean(marker && marker[1]) && checks.oneInstructionPerStep
      block = { kind, limit, words: 0, start: n, inToken: false, tokenIsWord: false, tokenLine: n,
        step, stepLine: n, firstDone: false, firstText: '' }
    }
    readProse(prose, n)
  }
  if (block) endBlock()
}

function validateFile(file) {
  const problems = []
  const warnings = []
  let text
  try {
    text = fs.readFileSync(file, 'utf8')
  } catch (err) {
    return { file, problems: [`unreadable: ${err.message}`], warnings, doc: null }
  }

  const parts = splitFrontmatter(text, file)
  if (parts.error) return { file, problems: [parts.error.replace(`${file}: `, '')], warnings, doc: null }
  const { fm, body } = parts

  const keys = topLevelKeys(fm)
  const doc = fmValue(fm, 'doc')

  for (const k of ENVELOPE) if (!keys.has(k)) problems.push(`missing envelope key: ${k}`)
  for (const k of RECOMMENDED) if (!keys.has(k)) warnings.push(`missing recommended key: ${k}`)

  if (!doc) return { file, problems, warnings, doc: null }
  const contract = TYPES[doc]
  if (!contract) {
    problems.push(`unknown doc type: ${doc} (known: ${Object.keys(TYPES).join(', ')})`)
    return { file, problems, warnings, doc }
  }

  for (const k of contract.keys) if (!keys.has(k)) problems.push(`missing ${doc} key: ${k}`)

  if (contract.budget !== null) {
    const bodyLines = body.filter((l) => l.trim() !== '').length
    if (bodyLines > contract.budget) {
      problems.push(`body ${bodyLines} non-empty lines exceeds ${doc} budget of ${contract.budget}`)
    }
  }

  // Required body sections per type (SCHEMAS.md); checked as line prefixes.
  const REQUIRED_SECTIONS = {
    verdict: ['## Verdict', '## Findings', '## Evidence check'],
    analyst: ['## Scorecard', '## Patterns', '## Proposals'],
    brief: ['## Answer'],
    plan_check: ['## Blind sketch', '## Comparison', '## Recommendations'],
    ledger: ['## Canon', '## World state'],
    review_report: ['## Scope', '## Findings', '## Context disclosure', '## Evidence'],
  }
  const required = REQUIRED_SECTIONS[doc]
  if (required) {
    for (const section of required) {
      if (!body.some((l) => l.startsWith(section))) {
        problems.push(`${doc} missing "${section}" section`)
      }
    }
  }

  switch (doc) {
    case 'plan': {
      const tier = fmValue(fm, 'tier')
      if (tier && !TIERS.includes(tier)) {
        problems.push(`invalid tier: ${tier} (allowed: ${TIERS.join('|')})`)
      }
      const slugs = nestedFieldValues(fm, 'items', 'slug')
      const statuses = nestedFieldValues(fm, 'items', 'status')
      if (slugs.length === 0) problems.push('plan has no items')
      const seen = new Set()
      for (const s of slugs) {
        if (seen.has(s)) problems.push(`duplicate item slug: ${s}`)
        seen.add(s)
      }
      for (const s of statuses) {
        if (!STATUSES.includes(s)) problems.push(`invalid item status: ${s} (allowed: ${STATUSES.join('|')})`)
      }
      for (const dep of nestedFieldValues(fm, 'items', 'depends_on')) {
        for (const d of dep.replace(/[[\]]/g, '').split(',').map((x) => x.trim()).filter((x) => x && x !== 'none')) {
          if (!seen.has(d)) problems.push(`depends_on references unknown slug: ${d}`)
        }
      }
      for (const t of nestedFieldValues(fm, 'items', 'trigger')) {
        if (!ATTEMPT_TRIGGERS.includes(t)) {
          problems.push(`invalid attempt trigger: ${t} (allowed: ${ATTEMPT_TRIGGERS.join('|')})`)
        }
      }
      const kind = fmValue(fm, 'kind')
      if (kind && !['build', 'research'].includes(kind)) {
        problems.push(`invalid plan kind: ${kind} (allowed: build|research)`)
      }
      if (kind !== 'research') {
        for (const s of seen) {
          if (!body.some((l) => l.startsWith(`## Packet: ${s}`))) {
            problems.push(`plan missing packet section for item: ${s}`)
          }
        }
        const entries = listEntries(fm, 'items')
        const slugPattern = new RegExp(`(?:^|[\\s{,])slug:\\s*(\\[[^\\]]*\\]|"[^"]*"|[^,}\\s]+)`)
        const statusPattern = new RegExp(`(?:^|[\\s{,])status:\\s*(\\[[^\\]]*\\]|"[^"]*"|[^,}\\s]+)`)
        for (const entry of entries) {
          const slugMatch = entry.match(slugPattern)
          const statusMatch = entry.match(statusPattern)
          if (slugMatch && statusMatch) {
            const slug = slugMatch[1].trim()
            const status = statusMatch[1].trim()
            if (status === 'done') {
              const vpath = path.join(path.dirname(file), 'reports', slug + '-verdict.md')
              if (!fs.existsSync(vpath)) {
                warnings.push(`done item '${slug}' has no reports/${slug}-verdict.md`)
              }
              if (!entry.includes('attempts:')) {
                warnings.push(`done item '${slug}' has no attempts record`)
              }
            }
          }
        }
      }
      if (keys.has('writing')) {
        const checks = loadPacketChecks(file, writingPreset(fm))
        if (checks) checkPackets(body, fm.length + 3, checks, warnings)
        else warnings.push(WRITING_SKIPPED)
      }
      break
    }
    case 'analyst': {
      const mode = fmValue(fm, 'mode') || 'standard' // older reports predate the mode key
      if (!ANALYST_BUDGETS[mode]) {
        problems.push(`invalid analyst mode: ${mode} (allowed: ${Object.keys(ANALYST_BUDGETS).join('|')})`)
      } else {
        const bodyLines = body.filter((l) => l.trim() !== '').length
        if (bodyLines > ANALYST_BUDGETS[mode]) {
          problems.push(`body ${bodyLines} non-empty lines exceeds ${mode} analyst budget of ${ANALYST_BUDGETS[mode]}`)
        }
        if (mode === 'intensive' && !body.some((l) => l.startsWith('## Proposal ledger'))) {
          problems.push('intensive analyst missing "## Proposal ledger" section')
        }
      }
      break
    }
    case 'research': {
      const depth = fmValue(fm, 'depth')
      if (!RESEARCH_BUDGETS[depth]) {
        problems.push(`invalid research depth: ${depth} (allowed: ${Object.keys(RESEARCH_BUDGETS).join('|')})`)
      } else {
        const bodyLines = body.filter((l) => l.trim() !== '').length
        if (bodyLines > RESEARCH_BUDGETS[depth]) {
          problems.push(`body ${bodyLines} non-empty lines exceeds ${depth} research budget of ${RESEARCH_BUDGETS[depth]}`)
        }
      }
      if (!body.some((l) => l.startsWith('## Verdict') || l.startsWith('## Recommendation'))) {
        problems.push('research missing "## Verdict" (or "## Recommendation") section')
      }
      if (!body.some((l) => l.startsWith('## Open questions'))) {
        problems.push('research missing "## Open questions" section')
      }
      break
    }
    case 'report': {
      const status = fmValue(fm, 'status')
      if (status && !['done', 'blocked'].includes(status)) problems.push(`invalid report status: ${status}`)
      if (status === 'blocked' && !body.some((l) => l.startsWith('## Blocked'))) {
        problems.push('blocked report missing "## Blocked" section')
      }
      if (!body.some((l) => l.startsWith('## Evidence'))) problems.push('report missing "## Evidence" section')
      break
    }
    case 'verdict': {
      const verdict = fmValue(fm, 'verdict')
      if (verdict && !['PASS', 'FAIL'].includes(verdict)) problems.push(`invalid verdict: ${verdict}`)
      for (const s of nestedFieldValues(fm, 'findings', 'severity')) {
        if (!SEVERITIES.includes(s)) problems.push(`invalid finding severity: ${s}`)
      }
      if (verdict === 'FAIL' && nestedFieldValues(fm, 'findings', 'severity').length === 0) {
        problems.push('FAIL verdict with no findings')
      }
      break
    }
    case 'brief': {
      const confidence = fmValue(fm, 'confidence')
      if (confidence && !['high', 'medium', 'low'].includes(confidence)) {
        problems.push(`invalid confidence: ${confidence}`)
      }
      break
    }
    case 'design_swag': {
      const readiness = fmValue(fm, 'readiness')
      const allowed = ['insufficient', 'needs_product', 'needs_tech', 'swaggable', 'likely_ready']
      if (readiness && !allowed.includes(readiness)) {
        problems.push(`invalid readiness: ${readiness} (allowed: ${allowed.join('|')})`)
      }
      const size = fmValue(fm, 'size_swag')
      const sizes = ['XS', 'S', 'M', 'L', 'XL', 'unknown']
      if (size && !sizes.includes(size)) {
        problems.push(`invalid size_swag: ${size}`)
      }
      for (const section of [
        '## What this seems to be',
        '## Likely shape of work',
        '## Codebase grounding',
        '## Decisions so far',
        '## Open questions',
        '## Not yet specified',
        '## Out of scope',
        '## Risks & unknowns',
        '## Readiness',
        '## Original request',
      ]) {
        if (!body.some((l) => l.startsWith(section))) {
          problems.push(`design_swag missing "${section}" section`)
        }
      }
      break
    }
    case 'review_report': {
      const contextTier = fmValue(fm, 'context_tier')
      if (contextTier && !CONTEXT_TIERS.includes(contextTier)) {
        problems.push(`invalid context_tier: ${contextTier} (allowed: ${CONTEXT_TIERS.join('|')})`)
      }
      const tier = fmValue(fm, 'tier')
      if (tier && !TIERS.includes(tier)) {
        problems.push(`invalid tier: ${tier} (allowed: ${TIERS.join('|')})`)
      }
      break
    }
    case 'ledger': {
      // Find section indices for Canon and World state
      const canonIdx = body.findIndex((l) => l.startsWith('## Canon'))
      const worldIdx = body.findIndex((l) => l.startsWith('## World state'))

      // Both sections are required
      if (canonIdx < 0) problems.push('ledger missing "## Canon" section')
      if (worldIdx < 0) problems.push('ledger missing "## World state" section')

      // Canon must come before World state (F1 fix: order check)
      if (canonIdx >= 0 && worldIdx >= 0 && canonIdx > worldIdx) {
        problems.push('ledger sections out of order: "## Canon" must come before "## World state"')
      }

      // Count C<n>. units in Canon section only (F2 fix: scoped counting)
      if (canonIdx >= 0) {
        const nextSectionIdx = body.findIndex(
          (l, i) => i > canonIdx && l.startsWith('## ') && !l.startsWith('## Canon')
        )
        const canonEnd = nextSectionIdx >= 0 ? nextSectionIdx : body.length
        const canonSection = body.slice(canonIdx + 1, canonEnd)
        const canonUnits = canonSection.filter((l) => /^C\d+\./.test(l.trim())).length
        if (canonUnits > 20) {
          warnings.push(`Canon has ${canonUnits} units (warn: ≤ 20)`)
        }
      }

      // Count W<n>. units in World state section only (F2 fix: scoped counting)
      if (worldIdx >= 0) {
        const nextSectionIdx = body.findIndex(
          (l, i) => i > worldIdx && l.startsWith('## ') && !l.startsWith('## World state')
        )
        const worldEnd = nextSectionIdx >= 0 ? nextSectionIdx : body.length
        const worldSection = body.slice(worldIdx + 1, worldEnd)
        const worldUnits = worldSection.filter((l) => /^W\d+\./.test(l.trim())).length
        if (worldUnits > 30) {
          warnings.push(`World state has ${worldUnits} live units (warn: ≤ 30)`)
        }
      }
      break
    }
    default:
      break
  }

  return { file, problems, warnings, doc }
}

function collectDefaultTargets(root) {
  const b = path.join(root, '.brigade', 'dishes')
  if (!fs.existsSync(b)) return []
  const targets = []
  for (const dish of fs.readdirSync(b)) {
    const dir = path.join(b, dish)
    if (!fs.statSync(dir).isDirectory()) continue
    for (const rel of ['PLAN.md', 'analyst.md', 'DESIGN.md']) {
      const f = path.join(dir, rel)
      if (fs.existsSync(f)) targets.push(f)
    }
    for (const sub of ['briefs', 'reports', 'research', 'state']) {
      const d = path.join(dir, sub)
      if (!fs.existsSync(d)) continue
      for (const f of fs.readdirSync(d)) if (f.endsWith('.md')) targets.push(path.join(d, f))
    }
  }
  return targets
}

function repoRoot() {
  const explicit = process.env.BRIGADE_PROJECT_DIR || process.env.CLAUDE_PROJECT_DIR ||
    process.env.CODEX_PROJECT_DIR
  if (explicit) return path.resolve(explicit)
  let cursor = process.cwd()
  while (true) {
    if (fs.existsSync(path.join(cursor, '.brigade'))) return cursor
    const parent = path.dirname(cursor)
    if (parent === cursor) break
    cursor = parent
  }
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], {
      cwd: process.cwd(),
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim()
  } catch {
    return process.cwd()
  }
}

function main() {
  const args = process.argv.slice(2)
  const json = args.includes('--json')
  const files = args.filter((a) => a !== '--json')
  const root = repoRoot()

  const targets = files.length > 0 ? files : collectDefaultTargets(root)
  if (targets.length === 0) {
    if (json) console.log(JSON.stringify({ checked: 0, ok: true, results: [] }))
    else console.log('brigade-validate: nothing to check (no .brigade/dishes artifacts found)')
    return 0
  }

  const results = targets.map(validateFile)
  const bad = results.filter((r) => r.problems.length > 0)

  if (json) {
    console.log(JSON.stringify({ checked: results.length, ok: bad.length === 0, results }, null, 2))
  } else {
    for (const r of results) {
      const rel = path.relative(root, r.file)
      if (r.problems.length === 0 && r.warnings.length === 0) {
        console.log(`ok    ${rel} (${r.doc ?? '?'})`)
      } else {
        for (const p of r.problems) console.log(`FAIL  ${rel}: ${p}`)
        for (const w of r.warnings) console.log(`warn  ${rel}: ${w}`)
      }
    }
    console.log(`\n${results.length} checked, ${bad.length} nonconforming`)
  }
  return bad.length > 0 ? 1 : 0
}

process.exitCode = main()
