#!/usr/bin/env node
// brigade-bundle — regenerates workflows/<name>.js from workflows/src/<name>.js
// + workflows/config.js.
//
// Workflow scripts run in a context that can't do runtime imports, so the
// shared config has to be spliced into each generated script at build time
// instead of required at run time. Each source file carries a single marker
// line (//@BRIGADE_CONFIG@) that this tool replaces with the full text of
// workflows/config.js, then appends a generated-file trailer.
//
// Some entries in workflows/config.js are themselves generated: the verdict schema lives in
// scripts/lib/schemas.mjs, and this tool rewrites the lines between each
// `// @schemas:begin <name>` and `// @schemas:end <name>` pair from that module before
// bundling. config.js keeps the literal text so tests can still evaluate it on its own.
//
// Usage:
//   brigade-bundle            # bundle every workflows/src/*.js, write outputs
//   brigade-bundle --check    # regenerate in memory, compare to committed
//                              # outputs; exit 1 if anything is stale/missing,
//                              # including config.js entries that no longer
//                              # match scripts/lib/schemas.mjs
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { VERDICT, SCHEMA_VERDICT_RETURN } from './lib/schemas.mjs'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const ROOT = path.join(__dirname, '..')
const WORKFLOWS_DIR = path.join(ROOT, 'workflows')
const SRC_DIR = path.join(WORKFLOWS_DIR, 'src')
const CONFIG_PATH = path.join(WORKFLOWS_DIR, 'config.js')
const MARKER = '//@BRIGADE_CONFIG@'

function die(msg) {
  process.stderr.write(`brigade-bundle: ${msg}\n`)
  process.exit(1)
}

function readConfigText() {
  if (!fs.existsSync(CONFIG_PATH)) die(`missing config: ${CONFIG_PATH}`)
  return fs.readFileSync(CONFIG_PATH, 'utf8')
}

// Writes a plain value as a one-line JS literal in config.js's own style: single-quoted
// strings, `{ key: value }` objects and `['a', 'b']` arrays.
function toJs(value) {
  if (typeof value === 'string') return `'${value.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, '\\n')}'`
  if (typeof value === 'number' || typeof value === 'boolean' || value === null) return String(value)
  if (Array.isArray(value)) return `[${value.map(toJs).join(', ')}]`
  if (typeof value === 'object') {
    const entries = Object.entries(value).map(([k, v]) => `${/^[A-Za-z_$][\w$]*$/.test(k) ? k : toJs(k)}: ${toJs(v)}`)
    return entries.length ? `{ ${entries.join(', ')} }` : '{}'
  }
  die(`cannot write a ${typeof value} into workflows/config.js`)
}

// Escapes text so it reads back unchanged from inside a template literal.
function toTemplate(text) {
  return '`' + text.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${') + '`'
}

// The config.js entries this tool owns, by marker name, and the lines each one holds.
const GENERATED = {
  'verdict-doc': () => [`  verdict: ${toTemplate(VERDICT.doc)},`],
  'verdict-return': () => [`const SCHEMA_VERDICT_RETURN = ${toJs(SCHEMA_VERDICT_RETURN)}`],
}

// Returns config.js's text with every generated entry rewritten from scripts/lib/schemas.mjs.
// Dies when a marker pair is missing, repeated or out of order, so a hand edit that drops a
// marker can't quietly turn the entry back into a hand-kept copy.
function regenerateConfig(configText) {
  let lines = linesOf(configText)
  for (const [name, render] of Object.entries(GENERATED)) {
    const begin = `// @schemas:begin ${name}`
    const end = `// @schemas:end ${name}`
    const at = (marker) => lines.map((l, i) => (l.trim() === marker ? i : -1)).filter((i) => i >= 0)
    const begins = at(begin)
    const ends = at(end)
    if (begins.length !== 1 || ends.length !== 1 || ends[0] < begins[0]) {
      die(`workflows/config.js needs exactly one '${begin}' line followed by one '${end}' line`)
    }
    lines = [...lines.slice(0, begins[0] + 1), ...render(), ...lines.slice(ends[0])]
  }
  return lines.join('\n') + '\n'
}

function listSrcFiles() {
  if (!fs.existsSync(SRC_DIR)) die(`missing src dir: ${SRC_DIR}`)
  const files = fs.readdirSync(SRC_DIR).filter((f) => f.endsWith('.js')).sort()
  if (files.length === 0) die(`empty src dir: ${SRC_DIR}`)
  return files
}

// Normalize text to lines with any single trailing newline stripped, so
// splitting and rejoining is lossless and deterministic. Strip CR so CRLF
// sources don't break the //@BRIGADE_CONFIG@ exact-match check.
function linesOf(text) {
  return text.replace(/\r\n/g, '\n').replace(/\r/g, '\n').replace(/\n$/, '').split('\n')
}

// Build the bundled text for one source file. Dies loudly (with the path)
// if the marker isn't present exactly once.
function bundle(srcPath, configText) {
  const raw = fs.readFileSync(srcPath, 'utf8')
  const srcLines = linesOf(raw)
  const markerLines = srcLines.filter((l) => l === MARKER).length
  if (markerLines !== 1) die(`missing marker ${MARKER} in ${srcPath}`)
  const markerIdx = srcLines.indexOf(MARKER)
  const configLines = linesOf(configText)
  const name = path.basename(srcPath, '.js')
  const trailer = `// GENERATED by scripts/brigade-bundle from workflows/src/${name}.js — edit the source, then re-run scripts/brigade-bundle`
  const outLines = [
    ...srcLines.slice(0, markerIdx),
    ...configLines,
    ...srcLines.slice(markerIdx + 1),
    trailer,
  ]
  return outLines.join('\n') + '\n'
}

function outputPathFor(srcFile) {
  const name = path.basename(srcFile, '.js')
  return path.join(WORKFLOWS_DIR, `${name}.js`)
}

function runCheck(srcFiles, configText) {
  let stale = false
  if (regenerateConfig(configText) !== linesOf(configText).join('\n') + '\n') {
    console.log('STALE: workflows/config.js (its verdict entries differ from scripts/lib/schemas.mjs)')
    stale = true
  }
  for (const f of srcFiles) {
    const expected = bundle(path.join(SRC_DIR, f), configText)
    const outPath = outputPathFor(f)
    const actual = fs.existsSync(outPath) ? fs.readFileSync(outPath, 'utf8') : null
    if (actual !== expected) {
      console.log(`STALE: ${path.relative(ROOT, outPath)}`)
      stale = true
    }
  }
  if (stale) process.exit(1)
  console.log('BUNDLE OK')
  process.exit(0)
}

function runBundle(srcFiles, rawConfigText) {
  const configText = regenerateConfig(rawConfigText)
  if (configText !== rawConfigText) {
    fs.writeFileSync(CONFIG_PATH, configText)
    console.log('regenerated workflows/config.js')
  }
  for (const f of srcFiles) {
    const content = bundle(path.join(SRC_DIR, f), configText)
    const outPath = outputPathFor(f)
    fs.writeFileSync(outPath, content)
    console.log(`bundled ${path.relative(ROOT, outPath)}`)
  }
  process.exit(0)
}

function main() {
  const check = process.argv.includes('--check')
  const configText = readConfigText()
  const srcFiles = listSrcFiles()
  if (check) runCheck(srcFiles, configText)
  else runBundle(srcFiles, configText)
}

main()
