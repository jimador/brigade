#!/usr/bin/env node
// brigade-coord — atomic single-writer leases shared by Claude and Codex Brigade.
//
// A lease protects one dish control plane. Different dishes may run concurrently.
// The lease is intentionally not time-expired: a paused human checkpoint is not proof
// that an owner died. `break --force` archives the old lease for operator-approved
// recovery instead of deleting its evidence.
import crypto from 'node:crypto'
import fs from 'node:fs'
import path from 'node:path'
import { execFileSync } from 'node:child_process'

const PREFLIGHT_TIMEOUT_MS = 10000

function repoRoot() {
  const explicit = process.env.BRIGADE_PROJECT_DIR || process.env.CLAUDE_PROJECT_DIR ||
    process.env.CODEX_PROJECT_DIR
  if (explicit) return path.resolve(explicit)
  let cursor = process.cwd()
  while (true) {
    if (fs.existsSync(path.join(cursor, '.brigade'))) return cursor
    const parent = path.dirname(cursor)
    if (parent === cursor) break
    cursor = parent
  }
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], {
      cwd: process.cwd(),
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim()
  } catch {
    return process.cwd()
  }
}

const root = repoRoot()
const coordinationRoot = path.join(root, '.brigade', 'coordination')
const command = process.argv[2]
const dish = process.argv[3]

function fail(message, code = 1) {
  process.stderr.write(`${message}\n`)
  process.exit(code)
}

function validDish(value) {
  return typeof value === 'string' && /^[a-z0-9][a-z0-9._-]*$/.test(value)
}

function leasePath(value) {
  if (!validDish(value)) fail('dish must match [a-z0-9][a-z0-9._-]*')
  return path.join(coordinationRoot, `${value}.lease`)
}

function mutexPath(value) {
  if (!validDish(value)) fail('dish must match [a-z0-9][a-z0-9._-]*')
  return path.join(coordinationRoot, `${value}.mutex`)
}

function withMutex(value, operation) {
  fs.mkdirSync(coordinationRoot, { recursive: true })
  try {
    fs.mkdirSync(mutexPath(value))
  } catch (error) {
    if (error && error.code === 'EEXIST') {
      fail(`coordination operation already active for ${value}`, 5)
    }
    throw error
  }
  try {
    return operation()
  } finally {
    fs.rmdirSync(mutexPath(value))
  }
}

function metadataPath(value) {
  const lease = leasePath(value)
  return fs.existsSync(lease) && fs.statSync(lease).isDirectory()
    ? path.join(lease, 'owner.json')
    : lease
}

function readMetadata(value) {
  const lease = leasePath(value)
  if (!fs.existsSync(lease)) return null
  try {
    return JSON.parse(fs.readFileSync(metadataPath(value), 'utf8'))
  } catch (error) {
    return { dish: value, invalid: true, error: error.message }
  }
}

function writeMetadata(value, metadata) {
  const file = metadataPath(value)
  const temporary = `${file}.tmp-${crypto.randomUUID()}`
  fs.writeFileSync(temporary, `${JSON.stringify(metadata, null, 2)}\n`, { flag: 'wx' })
  fs.renameSync(temporary, file)
}

function emit(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`)
}

function normalizeKey(value) {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
}

function unquote(value) {
  const trimmed = value.trim()
  if (trimmed.length >= 2 &&
      ((trimmed.startsWith('"') && trimmed.endsWith('"')) ||
       (trimmed.startsWith("'") && trimmed.endsWith("'")))) {
    return trimmed.slice(1, -1)
  }
  return trimmed
}

function planIdentity(file) {
  const lines = fs.readFileSync(file, 'utf8').split(/\r?\n/)
  const identity = {}
  let fences = 0
  for (const line of lines) {
    if (line === '---') {
      fences += 1
      if (fences === 2) break
      continue
    }
    if (fences !== 1) continue
    const match = line.match(/^(dish|source|ticket):\s*(.*)$/)
    if (match) identity[match[1]] = unquote(match[2])
  }
  return identity
}

// The functions below read a PLAN.md's items the same careful way brigade-validate does
// (precedent, not a shared import): each `- ` entry's own text block is kept together so
// its status and files come from the SAME entry. Querying "all statuses" and "all files"
// as separate flat arrays and zipping them by index would misalign the moment one entry
// is missing a field — exactly the trap a plan's items list can spring.
function splitFrontmatter(text) {
  const lines = text.split(/\r?\n/)
  if (lines[0] !== '---') return null
  const end = lines.indexOf('---', 1)
  if (end < 0) return null
  return { fm: lines.slice(1, end), body: lines.slice(end + 1) }
}

function readFrontmatterLines(file) {
  let text
  try {
    text = fs.readFileSync(file, 'utf8')
  } catch {
    return null
  }
  const parts = splitFrontmatter(text)
  return parts ? parts.fm : null
}

function listEntries(fm, listKey) {
  const entries = []
  let inList = false
  let current = []
  const flush = () => {
    if (current.length > 0) entries.push(current.join(' '))
    current = []
  }
  for (const line of fm) {
    if (/^[a-z_]+:/.test(line)) {
      flush()
      inList = line.startsWith(`${listKey}:`)
      continue
    }
    if (!inList) continue
    if (/^\s*- /.test(line)) {
      flush()
      current = [line]
    } else if (current.length > 0) {
      current.push(line)
    }
  }
  flush()
  return entries
}

function parseItemEntry(entry) {
  const slugMatch = entry.match(/(?:^|[\s{,])slug:\s*(\[[^\]]*\]|"[^"]*"|[^,}\s]+)/)
  const statusMatch = entry.match(/(?:^|[\s{,])status:\s*(\[[^\]]*\]|"[^"]*"|[^,}\s]+)/)
  const filesMatch = entry.match(/(?:^|[\s{,])files:\s*(\[[^\]]*\])/)
  const files = filesMatch
    ? filesMatch[1].replace(/[[\]]/g, '').split(',').map((f) => unquote(f.trim())).filter(Boolean)
    : []
  return {
    slug: slugMatch ? unquote(slugMatch[1].trim()) : null,
    // No status on an entry is treated as active (conservative) — only an explicit
    // `done` excludes it from the file-overlap scan.
    status: statusMatch ? unquote(statusMatch[1].trim()) : null,
    files,
  }
}

function planItems(file) {
  const fm = readFrontmatterLines(file)
  if (!fm) return []
  return listEntries(fm, 'items').map(parseItemEntry)
}

function planDeliveryBranch(file) {
  const fm = readFrontmatterLines(file)
  if (!fm) return null
  const line = fm.find((l) => l.startsWith('delivery_branch:'))
  return line ? unquote(line.slice('delivery_branch:'.length)) : null
}

if (command === 'key') {
  const source = process.argv[3]
  const ticket = process.argv[4]
  if (!source || !ticket) fail('key requires source and immutable ticket id')
  const matches = []
  const dishesRoot = path.join(root, '.brigade', 'dishes')
  if (fs.existsSync(dishesRoot)) {
    for (const entry of fs.readdirSync(dishesRoot)) {
      const file = path.join(dishesRoot, entry, 'PLAN.md')
      if (!fs.existsSync(file)) continue
      const identity = planIdentity(file)
      if (identity.source === source && identity.ticket === ticket) {
        matches.push(identity.dish || entry)
      }
    }
  }
  if (matches.length > 1) fail(`ambiguous existing dish identity for ${source}:${ticket}`, 4)
  if (matches.length === 1) {
    emit({ dish: matches[0], source, ticket, existing: true })
    process.exit(0)
  }
  const derived = normalizeKey(`${source}-${ticket}`)
  if (!derived) fail('source and ticket id normalize to an empty dish key')
  emit({ dish: derived, source, ticket, existing: false })
  process.exit(0)
}

if (command === 'review-key') {
  const ref = process.argv[3]
  if (!ref) fail('review-key requires a ref')
  const review = normalizeKey(ref)
  if (!review) fail('ref normalizes to an empty review key')
  emit({ review, lease: `review-${review}` })
  process.exit(0)
}

if (command === 'list') {
  if (!fs.existsSync(coordinationRoot)) {
    emit({ leases: [] })
    process.exit(0)
  }
  const leases = fs.readdirSync(coordinationRoot)
    .filter((name) => name.endsWith('.lease'))
    .sort()
    .map((name) => {
      const key = name.slice(0, -'.lease'.length)
      return {
        ...(readMetadata(key) || { dish: key, invalid: true }),
        operation_busy: fs.existsSync(mutexPath(key)),
      }
    })
  emit({ leases })
  process.exit(0)
}

if (command === 'watch') {
  // Long-running change feed for the plugin monitor: every emitted line becomes a model
  // notification in the session, so the bar is "would the planner act on this?". We
  // report what the OTHER runtime does — lease transitions, and new report/state
  // artifacts in dishes we don't hold — and stay silent about our own work, which the
  // session already knows about firsthand.
  const flags = process.argv.slice(3)
  const flagValue = (name) => {
    const at = flags.indexOf(name)
    return at >= 0 ? flags[at + 1] : undefined
  }
  const myRuntime = flagValue('--runtime') || 'claude'
  const intervalSeconds = Math.max(2, Number(flagValue('--interval')) || 5)
  const once = flags.includes('--once')
  const stateFile = flagValue('--state')
  const MAX_LINES_PER_TICK = 12

  function leaseSnapshot() {
    const leases = {}
    if (!fs.existsSync(coordinationRoot)) return leases
    for (const name of fs.readdirSync(coordinationRoot)) {
      if (!name.endsWith('.lease')) continue
      const key = name.slice(0, -'.lease'.length)
      // An unexpected filename would trip leasePath's validation exit; a watch skips it.
      if (!validDish(key)) continue
      const metadata = readMetadata(key)
      leases[key] = { runtime: metadata?.runtime || 'unknown', owner: metadata?.owner || '' }
    }
    return leases
  }

  function artifactSnapshot() {
    const artifacts = {}
    const dishesRoot = path.join(root, '.brigade', 'dishes')
    if (!fs.existsSync(dishesRoot)) return artifacts
    for (const dishEntry of fs.readdirSync(dishesRoot)) {
      for (const kind of ['reports', 'state']) {
        const dir = path.join(dishesRoot, dishEntry, kind)
        if (!fs.existsSync(dir)) continue
        for (const file of fs.readdirSync(dir)) {
          if (!file.endsWith('.md')) continue
          const full = path.join(dir, file)
          try {
            artifacts[`${dishEntry}/${kind}/${file}`] = fs.statSync(full).mtimeMs
          } catch {
            // Raced a delete; skip.
          }
        }
      }
    }
    return artifacts
  }

  function diff(previous, current) {
    const lines = []
    for (const [key, lease] of Object.entries(current.leases)) {
      const before = previous.leases[key]
      if (!before && lease.runtime !== myRuntime) {
        lines.push(`lease acquired: ${key} (${lease.runtime})`)
      } else if (before && before.owner !== lease.owner && lease.runtime !== myRuntime) {
        lines.push(`lease changed hands: ${key} (${before.runtime} -> ${lease.runtime})`)
      }
    }
    for (const [key, lease] of Object.entries(previous.leases)) {
      if (!current.leases[key] && lease.runtime !== myRuntime) {
        lines.push(`lease released: ${key} (was ${lease.runtime})`)
      }
    }
    for (const [key, mtime] of Object.entries(current.artifacts)) {
      const dishKey = key.split('/')[0]
      // Our own dishes report through the session's own workflow notifications. When a
      // dish is unheld at tick time, fall back to who held it LAST tick — that covers
      // the write-then-release race without echoing our own end-of-dish artifacts. A
      // release-then-foreign-acquire inside one tick can still misattribute; the feed
      // is advisory and brigade-status stays the source of truth.
      const holder = current.leases[dishKey] || previous.leases[dishKey]
      if (holder && holder.runtime === myRuntime) continue
      const before = previous.artifacts[key]
      if (before === undefined) lines.push(`artifact landed: ${key}`)
      else if (before !== mtime) lines.push(`artifact updated: ${key}`)
    }
    return lines
  }

  function emitLines(lines) {
    const shown = lines.slice(0, MAX_LINES_PER_TICK)
    for (const line of shown) process.stdout.write(`brigade-coord: ${line}\n`)
    if (lines.length > shown.length) {
      process.stdout.write(`brigade-coord: +${lines.length - shown.length} more changes (run brigade-status)\n`)
    }
  }

  function snapshot() {
    return { leases: leaseSnapshot(), artifacts: artifactSnapshot() }
  }

  if (once) {
    // Single diff pass against a state file — this is the testable core of the loop.
    if (!stateFile) fail('watch --once requires --state <file>')
    let previous = null
    try {
      previous = JSON.parse(fs.readFileSync(stateFile, 'utf8'))
    } catch {
      previous = null
    }
    const current = snapshot()
    if (previous) emitLines(diff(previous, current))
    fs.writeFileSync(stateFile, `${JSON.stringify(current)}\n`)
    process.exit(0)
  }

  let previous = snapshot() // Baseline tick emits nothing.
  setInterval(() => {
    try {
      if (!fs.existsSync(path.join(root, '.brigade'))) return
      const current = snapshot()
      emitLines(diff(previous, current))
      previous = current
    } catch {
      // A watch tick is never worth crashing the monitor over.
    }
  }, intervalSeconds * 1000)
} else if (!dish && command !== 'preflight') {
  // preflight's own usage guard (below) maps a missing dish-slug to exit code 2 per its
  // contract, so it needs to run instead of this generic exit-1 gate.
  fail('usage: brigade-coord key|review-key|acquire|status|heartbeat|release|break|list|watch|preflight [...]')
}

if (command === 'status') {
  const metadata = readMetadata(dish)
  emit({
    ...(metadata ? { held: true, ...metadata } : { held: false, dish }),
    operation_busy: fs.existsSync(mutexPath(dish)),
  })
  process.exit(0)
}

if (command === 'acquire') {
  const runtime = process.argv[4]
  if (!['claude', 'codex'].includes(runtime)) fail('runtime must be claude or codex')
  const now = new Date().toISOString()
  const owner = `${runtime}-${crypto.randomUUID()}`
  const metadata = {
    schema: 1,
    dish,
    runtime,
    owner,
    acquired_at: now,
    heartbeat_at: now,
  }
  const result = withMutex(dish, () => {
    try {
      fs.writeFileSync(leasePath(dish), `${JSON.stringify(metadata, null, 2)}\n`, {
        flag: 'wx',
      })
    } catch (error) {
      if (error && ['EEXIST', 'EISDIR'].includes(error.code)) {
        const holder = readMetadata(dish)
        return {
          code: 3,
          output: { acquired: false, held: true, ...(holder || { dish, invalid: true }) },
        }
      }
      throw error
    }
    return { code: 0, output: { acquired: true, ...metadata } }
  })
  emit(result.output)
  process.exit(result.code)
}

if (command === 'heartbeat') {
  const owner = process.argv[4]
  if (!owner) fail('heartbeat requires the owner token')
  const metadata = withMutex(dish, () => {
    const current = readMetadata(dish)
    if (!current) return { error: `no lease for ${dish}`, code: 4 }
    if (current.invalid) {
      return { error: `invalid lease metadata for ${dish}; operator-approved break required`, code: 4 }
    }
    if (current.owner !== owner) return { error: `lease owner mismatch for ${dish}`, code: 2 }
    current.heartbeat_at = new Date().toISOString()
    writeMetadata(dish, current)
    return current
  })
  if (metadata.error) fail(metadata.error, metadata.code)
  emit({ heartbeat: true, ...metadata })
  process.exit(0)
}

if (command === 'release') {
  const owner = process.argv[4]
  if (!owner) fail('release requires the owner token')
  const metadata = withMutex(dish, () => {
    const current = readMetadata(dish)
    if (!current) return { error: `no lease for ${dish}`, code: 4 }
    if (current.invalid) {
      return { error: `invalid lease metadata for ${dish}; operator-approved break required`, code: 4 }
    }
    if (current.owner !== owner) return { error: `lease owner mismatch for ${dish}`, code: 2 }
    const lease = leasePath(dish)
    if (fs.statSync(lease).isDirectory()) {
      for (const entry of fs.readdirSync(lease)) {
        if (entry !== 'owner.json' && !entry.startsWith('owner.json.tmp-')) {
          return {
            error: `unexpected lease entry ${entry}; operator-approved break required`,
            code: 4,
          }
        }
        fs.unlinkSync(path.join(lease, entry))
      }
      fs.rmdirSync(lease)
    } else {
      fs.unlinkSync(lease)
    }
    return current
  })
  if (metadata.error) fail(metadata.error, metadata.code)
  emit({ released: true, dish, runtime: metadata.runtime, owner })
  process.exit(0)
}

if (command === 'break') {
  if (process.argv[4] !== '--force') fail('break requires explicit --force')
  const result = withMutex(dish, () => {
    const metadata = readMetadata(dish)
    if (!metadata) return null
    const stamp = new Date().toISOString().replace(/[:.]/g, '-')
    const archive = path.join(coordinationRoot, `${dish}.broken-${stamp}-${crypto.randomUUID()}`)
    fs.renameSync(leasePath(dish), archive)
    return { metadata, archive }
  })
  if (!result) fail(`no lease for ${dish}`, 4)
  emit({ broken: true, dish, previous: result.metadata, archived_at: result.archive })
  process.exit(0)
}

if (command === 'recover-lock') {
  if (process.argv[4] !== '--force') fail('recover-lock requires explicit --force')
  const mutex = mutexPath(dish)
  if (!fs.existsSync(mutex)) fail(`no operation lock for ${dish}`, 4)
  const stamp = new Date().toISOString().replace(/[:.]/g, '-')
  const archive = path.join(coordinationRoot, `${dish}.mutex-broken-${stamp}-${crypto.randomUUID()}`)
  fs.renameSync(mutex, archive)
  emit({ recovered: true, dish, archived_at: archive })
  process.exit(0)
}

if (command === 'preflight') {
  // Zero-model-cost "is anything already in flight?" check for dish pre-flight: local and
  // remote branch collisions, an open PR already on the branch, files another active
  // dish's plan still has in flight, and two dishes racing to cut the same delivery
  // branch before either has pushed it. Every check reports independently; a soft-fail
  // (no remote, no gh) is recorded UNCHECKED with a reason, never silently ok.
  if (!dish) fail('usage: brigade-coord preflight <dish-slug> --branch <name> [--json]', 2)
  const rest = process.argv.slice(4)
  const branchAt = rest.indexOf('--branch')
  const branch = branchAt >= 0 ? rest[branchAt + 1] : undefined
  if (!branch) fail('preflight requires --branch <name>', 2)
  const asJson = rest.includes('--json')

  const dishesRoot = path.join(root, '.brigade', 'dishes')
  const ownPlan = path.join(dishesRoot, dish, 'PLAN.md')
  if (!fs.existsSync(ownPlan)) fail(`no PLAN.md for dish ${dish}: ${ownPlan}`, 2)

  const conflicts = []
  const unchecked = []

  // local-branch
  let localExists = false
  try {
    execFileSync('git', ['show-ref', '--verify', '--quiet', `refs/heads/${branch}`], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    })
    localExists = true
  } catch {
    localExists = false
  }
  if (localExists) conflicts.push({ kind: 'local-branch', detail: branch })

  // remote-branch + open-pr — both require an origin remote to mean anything.
  let hasOrigin = true
  try {
    execFileSync('git', ['remote', 'get-url', 'origin'], {
      cwd: root,
      stdio: ['ignore', 'ignore', 'ignore'],
    })
  } catch {
    hasOrigin = false
  }
  if (!hasOrigin) {
    unchecked.push({ kind: 'remote-branch', reason: 'no origin remote configured' })
    unchecked.push({ kind: 'open-pr', reason: 'no origin remote to check PRs against' })
  } else {
    try {
      const out = execFileSync('git', ['ls-remote', '--heads', 'origin', branch], {
        cwd: root,
        encoding: 'utf8',
        timeout: PREFLIGHT_TIMEOUT_MS,
        stdio: ['ignore', 'pipe', 'pipe'],
      })
      if (out.trim().length > 0) conflicts.push({ kind: 'remote-branch', detail: branch })
    } catch (error) {
      unchecked.push({ kind: 'remote-branch', reason: `git ls-remote failed: ${error.message}` })
    }

    const ghBin = process.env.BRIGADE_COORD_GH || 'gh'
    try {
      const out = execFileSync(
        ghBin,
        ['pr', 'list', '--head', branch, '--state', 'open', '--json', 'number,url'],
        { cwd: root, encoding: 'utf8', timeout: PREFLIGHT_TIMEOUT_MS, stdio: ['ignore', 'pipe', 'pipe'] },
      )
      const prs = JSON.parse(out)
      if (Array.isArray(prs) && prs.length > 0) {
        conflicts.push({ kind: 'open-pr', detail: { number: prs[0].number, url: prs[0].url } })
      }
    } catch (error) {
      unchecked.push({ kind: 'open-pr', reason: `${ghBin} pr list failed: ${error.message}` })
    }
  }

  // file-overlap: every OTHER dish's non-done items, intersected with this dish's own
  // items' files. delivery-branch: any OTHER dish's plan claiming the same branch.
  const ownFiles = new Set()
  for (const entry of planItems(ownPlan)) for (const f of entry.files) ownFiles.add(f)

  if (fs.existsSync(dishesRoot)) {
    for (const otherSlug of fs.readdirSync(dishesRoot)) {
      if (otherSlug === dish) continue
      const otherPlan = path.join(dishesRoot, otherSlug, 'PLAN.md')
      if (!fs.existsSync(otherPlan)) continue

      for (const entry of planItems(otherPlan)) {
        if (entry.status === 'done') continue
        const overlap = entry.files.filter((f) => ownFiles.has(f))
        if (overlap.length > 0) {
          conflicts.push({
            kind: 'file-overlap',
            detail: { other_dish: otherSlug, item: entry.slug, files: overlap },
          })
        }
      }

      const otherBranch = planDeliveryBranch(otherPlan)
      if (otherBranch && otherBranch === branch) {
        conflicts.push({
          kind: 'delivery-branch',
          detail: { other_dish: otherSlug, delivery_branch: otherBranch },
        })
      }
    }
  }

  const ok = conflicts.length === 0
  if (asJson) {
    emit({ ok, conflicts, unchecked })
  } else {
    for (const c of conflicts) process.stdout.write(`conflict: ${c.kind} ${JSON.stringify(c.detail)}\n`)
    for (const u of unchecked) process.stdout.write(`unchecked: ${u.kind} (${u.reason})\n`)
    process.stdout.write(ok ? 'preflight: ok\n' : 'preflight: conflicts\n')
  }
  process.exit(ok ? 0 : 1)
}

if (command !== 'watch') {
  fail('usage: brigade-coord key|review-key|acquire|status|heartbeat|release|break|recover-lock|list|watch|preflight [...]')
}
