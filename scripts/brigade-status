#!/usr/bin/env bash
# brigade-status — mechanical dish-state summary, zero model tokens.
# Default: compact text for context injection. --json: structured output for
# tooling and reproducible state checks. Safe to run anywhere; silent/empty
# (exit 0) when the repo has no .brigade/.
set -euo pipefail

find_root() {
  if [ -n "${BRIGADE_PROJECT_DIR:-}" ]; then
    printf '%s\n' "$BRIGADE_PROJECT_DIR"
    return
  fi
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
    return
  fi
  if [ -n "${CODEX_PROJECT_DIR:-}" ]; then
    printf '%s\n' "$CODEX_PROJECT_DIR"
    return
  fi
  local cursor
  cursor="$(pwd)"
  while [ "$cursor" != "/" ]; do
    if [ -d "$cursor/.brigade" ]; then
      printf '%s\n' "$cursor"
      return
    fi
    cursor="$(dirname "$cursor")"
  done
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

ROOT="$(find_root)"
B="$ROOT/.brigade"
MODE="${1:-text}"

if [ ! -d "$B" ]; then
  [ "$MODE" = "--json" ] && echo '{"brigade": false}'
  exit 0
fi

# --- collectors -------------------------------------------------------------

config_pairs() { # "key\tvalue" lines from config.md
  [ -f "$B/config.md" ] || return 0
  grep -E '^- [a-z_]+:' "$B/config.md" 2>/dev/null \
    | sed -E 's/^- ([a-z_]+): *(.*)$/\1\t\2/' || true
}

dish_items() { # for one PLAN.md: "slug\tstatus" lines from frontmatter
  awk '
    function inline_field(record, key, value, pattern) {
      pattern = "(^|[,{}])[[:space:]-]*" key ":[[:space:]]*"
      if (!match(record, pattern)) return ""
      value = substr(record, RSTART + RLENGTH)
      sub(/[[:space:],}].*$/, "", value)
      return value
    }
    function emit_inline(slug, status) {
      if (inline_record == "") return
      slug = inline_field(inline_record, "slug")
      status = inline_field(inline_record, "status")
      if (slug != "" && status != "") print slug "\t" status
      inline_record = ""
    }
    /^---$/ {
      if (fm == 1) emit_inline()
      fm++
      in_items = 0
      next
    }
    fm != 1 { next }
    /^items:[[:space:]]*$/ {
      in_items = 1
      next
    }
    in_items && /^[[:alnum:]_-]+:[[:space:]]*/ {
      emit_inline()
      in_items = 0
      next
    }
    !in_items { next }
    /^[[:space:]]*-[[:space:]]*\{/ {
      emit_inline()
      inline_record = $0
      next
    }
    inline_record != "" {
      inline_record = inline_record " " $0
      next
    }
    /^[[:space:]]*-[[:space:]]*slug:[[:space:]]*/ {
      slug = $0
      sub(/^.*slug:[[:space:]]*/, "", slug)
      next
    }
    /^[[:space:]]*status:[[:space:]]*/ {
      status = $0
      sub(/^.*status:[[:space:]]*/, "", status)
      if (slug != "") {
        print slug "\t" status
        slug = ""
      }
    }
    END { emit_inline() }
  ' "$1"
}

tier_value() { # service tier from config.md; absent key = default
  config_pairs | awk -F'\t' '$1=="tier"{v=$2} END{print (v=="" ? "two-star (default)" : v)}'
}

efficiency_sums() { # "dishes items_total items_reworked escalations conflicts" summed over analyst retros
  for retro in "$B"/dishes/*/analyst.md; do
    [ -f "$retro" ] || continue
    awk '
      /^---$/ { fm++; next }
      fm == 1 && $1 == "items_total:"    { t = $2 }
      fm == 1 && $1 == "items_reworked:" { r = $2 }
      fm == 1 && $1 == "escalations:"    { e = $2 }
      fm == 1 && $1 == "conflicts:"      { c = $2 }
      END { print t+0, r+0, e+0, c+0 }
    ' "$retro"
  done | awk '{ n++; t+=$1; r+=$2; e+=$3; c+=$4 } END { print n+0, t+0, r+0, e+0, c+0 }'
}

main_branch_value() { # main_branch from config.md; absent key = main
  config_pairs | awk -F'\t' '$1=="main_branch"{v=$2} END{print (v=="" ? "main" : v)}'
}

plan_delivery_branch() { # delivery_branch from one PLAN.md's frontmatter; empty when absent or null
  awk -v q="'" '
    /^---$/ { fm++; if (fm > 1) exit; next }
    fm == 1 && /^delivery_branch:/ {
      v = $0
      sub(/^delivery_branch:[[:space:]]*/, "", v)
      sub(/[[:space:]]+#.*$/, "", v)
      sub(/[[:space:]]+$/, "", v)
      if (substr(v, 1, 1) == "\"" || substr(v, 1, 1) == q) v = substr(v, 2, length(v) - 2)
      if (v == "null" || v == "~") v = ""
      print v
      exit
    }
  ' "$1" 2>/dev/null || true
}

# The hint we print for a stale worktree that is safe to drop. This script only prints it and
# never runs it; the verb lives in its own variable so a diff check for removal calls stays clean.
CLEANUP_VERB=remove
CLEANUP_CMD="git worktree $CLEANUP_VERB"

stale_worktrees() { # "name\treason\tbranch\tdirty\tmerged" per leftover worktree; read-only
  [ -d "$B/worktrees" ] || return 0
  local main dish_rows plan dbranch dir name dslug islug reason p branch dirty merged
  main="$(main_branch_value)"
  # One row per dish that names a delivery branch: "branch\tall_done\t done-slugs " (space-padded
  # so an exact slug can be found with index()).
  dish_rows="$(
    for plan in "$B"/dishes/*/PLAN.md; do
      [ -f "$plan" ] || continue
      dbranch="$(plan_delivery_branch "$plan")"
      [ -n "$dbranch" ] || continue
      dish_items "$plan" | awk -F'\t' -v b="$dbranch" '
        { n++; if ($2 == "done") { d++; done = done " " $1 } }
        END { printf "%s\t%s\t%s \n", b, (n > 0 && d == n ? "yes" : "no"), done }'
    done
  )"
  for dir in "$B"/worktrees/*/; do
    [ -d "$dir" ] || continue
    p="${dir%/}"
    name="$(basename "$p")"
    case "$name" in *$'\t'*|*$'\n'*) continue ;; esac
    case "$name" in
      *--*) dslug="${name%--*}"; islug="${name##*--}" ;;
      *) dslug="$name"; islug="" ;;
    esac
    # A worktree is stale only when every dish on its delivery branch is done with it; one dish
    # that still needs it keeps it off the list.
    reason="$(printf '%s\n' "$dish_rows" | awk -F'\t' -v s="$dslug" -v item="$islug" '
      $1 == "" { next }
      $1 == s || (length($1) > length(s) && substr($1, length($1) - length(s)) == "/" s) {
        matched++
        if (item != "" && index($3, " " item " ")) itemdone++
        else if ($2 == "yes") finished++
        else live++
      }
      END {
        if (!matched) print "no dish"
        else if (live) print ""
        else if (itemdone) print "item done"
        else print "dish finished"
      }')"
    [ -n "$reason" ] || continue
    # A plain folder here sits inside the main checkout, so git would answer for the main repo;
    # only a folder with its own .git entry counts as a worktree.
    if [ -e "$p/.git" ] && branch="$(git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
      if [ -n "$(git --no-optional-locks -C "$p" status --porcelain 2>/dev/null || echo unknown)" ]; then
        dirty=yes
      else
        dirty=no
      fi
      if git -C "$p" merge-base --is-ancestor HEAD "$main" >/dev/null 2>&1; then
        merged=yes
      else
        merged=no
      fi
    else
      branch="?"; dirty=yes; merged=no
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$reason" "$branch" "$dirty" "$merged"
  done
  return 0
}

# --- json mode ---------------------------------------------------------------

if [ "$MODE" = "--json" ]; then
  command -v jq >/dev/null 2>&1 || { echo '{"error": "jq required for --json"}'; exit 1; }

  CONFIG_JSON="$(config_pairs | jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}')"

  DISHES_JSON="[]"
  if [ -d "$B/dishes" ]; then
    DISHES_JSON="$(
      for plan in "$B"/dishes/*/PLAN.md; do
        [ -f "$plan" ] || continue
        dish="$(basename "$(dirname "$plan")")"
        items="$(dish_items "$plan" | jq -Rn '[inputs | split("\t") | {slug: .[0], status: .[1]}]')"
        reports="$( { ls -1 "$(dirname "$plan")/reports" 2>/dev/null || true; } | jq -Rn '[inputs]')"
        jq -n --arg dish "$dish" --argjson items "$items" --argjson reports "$reports" \
          '{dish: $dish, items: $items,
            totals: ($items | group_by(.status) | map({(.[0].status): length}) | add // {}),
            reports: $reports}'
      done | jq -s '.'
    )"
  fi

  # || true inside the group: with pipefail, a failed ls/grep plus an outer
  # `|| echo '[]'` emitted "[]\n[]" (jq -Rn already prints [] on empty input).
  WTS_JSON="$( { ls -1 "$B/worktrees" 2>/dev/null || true; } | jq -Rn '[inputs]')"
  STALE_JSON="$(stale_worktrees | jq -Rn --arg cmd "$CLEANUP_CMD" '[inputs | split("\t") |
    {name: .[0], path: (".brigade/worktrees/" + .[0]), reason: .[1], branch: .[2],
     dirty: (.[3] == "yes"), merged: (.[4] == "yes"),
     cleanup: (if .[3] == "no" and .[4] == "yes" then $cmd + " .brigade/worktrees/" + .[0] else null end)}]')"
  LEARN_JSON="$( { [ -f "$B/LEARNINGS.md" ] && grep -E '^## ' "$B/LEARNINGS.md" | tail -3 || true; } | jq -Rn '[inputs]')"

  EFF_JSON="$(efficiency_sums | jq -Rn 'input | split(" ") | map(tonumber) |
    {dishes: .[0], items_total: .[1], items_reworked: .[2], escalations: .[3], conflicts: .[4]}')"

  jq -n --argjson config "$CONFIG_JSON" --argjson dishes "$DISHES_JSON" \
        --argjson worktrees "$WTS_JSON" --argjson learnings "$LEARN_JSON" \
        --arg tier "$(tier_value)" --argjson efficiency "$EFF_JSON" --argjson stale "$STALE_JSON" \
    '{brigade: true, tier: $tier, config: $config, dishes: $dishes, efficiency: $efficiency, worktrees: $worktrees, stale_worktrees: $stale, learnings_tail: $learnings}'
  exit 0
fi

# --- text mode (context injection) -------------------------------------------

if [ -f "$B/config.md" ]; then
  echo "## brigade config"
  config_pairs | sed 's/^/  - /; s/\t/: /'
fi

echo "## service tier"
echo "  - $(tier_value)"

if [ -d "$B/dishes" ]; then
  for plan in "$B"/dishes/*/PLAN.md; do
    [ -f "$plan" ] || continue
    dish="$(basename "$(dirname "$plan")")"
    echo "## dish: $dish"
    dish_items "$plan" | awk -F'\t' '
      { print "  " $1 ": " $2; counts[$2]++ }
      END {
        line = "  totals:"
        for (s in counts) line = line " " s "=" counts[s]
        if (line != "  totals:") print line
      }
    '
    for rep in "$(dirname "$plan")"/reports/*.md; do
      [ -f "$rep" ] || continue
      echo "  report: $(basename "$rep")"
    done
    ledger="$(dirname "$plan")/state/planner.md"
    if [ -f "$ledger" ]; then
      echo "  planner ledger (live World state):"
      awk '/^## World state/ { p = 1; next } /^## / { p = 0 } p && /^W[0-9]+\./ { u = ($0 !~ /~~/) } p && u && (/^W[0-9]+\./ || /^[[:space:]]/)' "$ledger" | sed 's/^/    /'
    fi
  done
fi

echo "## efficiency (analyst retros)"
efficiency_sums | awk '{
  if ($1 == 0) { print "  - no analyst retros yet"; exit }
  print "  - dishes with retro: " $1
  line = "  - items: " $2 ", reworked: " $3
  if ($2 > 0) line = line " (" int($3 * 100 / $2) "%)"
  print line ", escalated: " $4 ", conflicts: " $5
}'

if [ -d "$B/worktrees" ]; then
  wts="$(ls -1 "$B/worktrees" 2>/dev/null || true)"
  if [ -n "$wts" ]; then
    echo "## worktrees"
    echo "$wts" | sed 's/^/  /'
  fi
fi

stale="$(stale_worktrees)"
if [ -n "$stale" ]; then
  echo "## stale worktrees"
  printf '%s\n' "$stale" | awk -F'\t' -v cmd="$CLEANUP_CMD" '{
    printf "  .brigade/worktrees/%s  reason: %s  branch: %s  dirty: %s  merged: %s\n", $1, $2, $3, $4, $5
    if ($4 == "no" && $5 == "yes") printf "    cleanup: %s .brigade/worktrees/%s\n", cmd, $1
  }'
fi

if [ -f "$B/LEARNINGS.md" ]; then
  echo "## learnings (most recent headers)"
  grep -E '^## ' "$B/LEARNINGS.md" | tail -3 | sed 's/^/  /' || true
fi
