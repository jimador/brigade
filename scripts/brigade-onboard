#!/usr/bin/env node
// brigade-onboard — checks and applies the one-time setup a repo needs before the
// brigade fleet can run in it: a .git/info/exclude entry so .brigade/ scratch never
// gets committed by accident, a record of which plugin version last touched this
// repo, and a board config file the onboarding skill walks a human through. `status`
// reports state; `apply` converges the automatic steps and records the result;
// `detect` reads repo signals (read-only) so the onboarding skill only has to ask
// the operator what it can't infer.
//
// Usage:
//   brigade-onboard status [--json]
//   brigade-onboard apply  [--json]
//   brigade-onboard detect [--json]
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = path.dirname(fileURLToPath(import.meta.url))

function repoRoot() {
  const explicit = process.env.CLAUDE_PROJECT_DIR
  return explicit ? path.resolve(explicit) : process.cwd()
}

function pluginRoot() {
  const explicit = process.env.BRIGADE_PLUGIN_ROOT
  return explicit ? path.resolve(explicit) : path.resolve(__dirname, '..')
}

function installedVersion(pluginRootDir) {
  const manifestPath = path.join(pluginRootDir, '.claude-plugin', 'plugin.json')
  const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
  return manifest.version
}

function onboardRecordPath(root) {
  return path.join(root, '.brigade', 'onboard.json')
}

// Reads the onboard record. Anything short of a clean parse — missing file,
// unreadable, corrupt JSON — comes back as null so callers treat it as "no record
// yet" instead of crashing.
function readOnboardRecord(root) {
  try {
    const text = fs.readFileSync(onboardRecordPath(root), 'utf8')
    return JSON.parse(text)
  } catch {
    return null
  }
}

function hasGitDir(root) {
  return fs.existsSync(path.join(root, '.git'))
}

function nowIso() {
  return new Date().toISOString()
}

function gitExcludeHasEntry(root) {
  const excludePath = path.join(root, '.git', 'info', 'exclude')
  let text
  try {
    text = fs.readFileSync(excludePath, 'utf8')
  } catch {
    return false
  }
  return text.split('\n').some((line) => line === '.brigade/')
}

// The step registry: one entry per thing onboarding cares about, in the order
// they should be shown and (later) applied. `apply` bodies land in a later work
// item — for now every step only knows how to check itself.
function buildSteps(root) {
  return [
    {
      id: 'git-exclude',
      kind: 'auto',
      check() {
        if (!hasGitDir(root)) return 'na'
        return gitExcludeHasEntry(root) ? 'ok' : 'pending'
      },
      // Appends a .brigade/ line to .git/info/exclude, creating the info/ dir and
      // the exclude file if either is missing. Only ever called when check() has
      // already reported 'pending', so the line is known absent — no dedup needed.
      // Never touches the tracked .gitignore.
      apply() {
        const infoDir = path.join(root, '.git', 'info')
        fs.mkdirSync(infoDir, { recursive: true })
        const excludePath = path.join(infoDir, 'exclude')
        let text = ''
        try {
          text = fs.readFileSync(excludePath, 'utf8')
        } catch {
          text = ''
        }
        const sep = text.length === 0 || text.endsWith('\n') ? '' : '\n'
        fs.writeFileSync(excludePath, `${text}${sep}.brigade/\n`)
        return 'appended .brigade/ to .git/info/exclude'
      },
    },
    {
      id: 'version-record',
      kind: 'auto',
      check(installed) {
        const record = readOnboardRecord(root)
        if (record && record.plugin_version === installed) return 'ok'
        return 'pending'
      },
      // The actual write happens in runApply (it needs to see what every other
      // step just did, so it can stamp only the steps that changed this run and
      // carry forward everything else) — this step's own apply body is unused.
      apply: null,
    },
    {
      id: 'board-config',
      kind: 'interactive',
      check() {
        return fs.existsSync(path.join(root, '.brigade', 'config.md')) ? 'ok' : 'pending'
      },
      apply: null,
    },
  ]
}

function stepDetail(step, state) {
  switch (step.id) {
    case 'git-exclude':
      return state === 'na' ? 'no .git directory' : state === 'ok' ? '.brigade/ excluded' : '.brigade/ not excluded'
    case 'version-record':
      return state === 'ok' ? 'recorded version matches installed' : 'no matching version record'
    case 'board-config':
      return state === 'ok' ? '.brigade/config.md present' : '.brigade/config.md missing'
    default:
      return state
  }
}

function runStatus(json) {
  const root = repoRoot()
  const plugRoot = pluginRoot()
  const installed = installedVersion(plugRoot)
  const record = readOnboardRecord(root)
  const recordedVersion = record && typeof record.plugin_version === 'string' ? record.plugin_version : null

  const steps = buildSteps(root)
  const results = steps.map((step) => ({ step, state: step.check(installed) }))

  const versionDrift = recordedVersion === null || recordedVersion !== installed
  const anyAutoPending = results.some((r) => r.step.kind === 'auto' && r.state === 'pending')
  const drift = versionDrift || anyAutoPending

  if (json) {
    console.log(JSON.stringify({
      schema: 1,
      plugin_version: installed,
      recorded_version: recordedVersion,
      drift,
      steps: results.map((r) => ({ id: r.step.id, kind: r.step.kind, state: r.state })),
    }))
  } else {
    for (const r of results) {
      console.log(`${r.state}  ${r.step.id}  ${stepDetail(r.step, r.state)}`)
    }
    console.log(`plugin_version: ${installed}`)
    console.log(`recorded_version: ${recordedVersion ?? '(none)'}`)
    console.log(`drift: ${drift ? 'yes' : 'no'}`)
  }
  return 0
}

// Runs every pending auto step's apply(), in registry order, then writes
// .brigade/onboard.json once with the installed version and per-step timestamps.
// version-record always writes last so that single write captures whatever the
// other steps just converged, plus its own timestamps carried forward from any
// prior record. Interactive steps (board-config) are never touched here.
function runApply(json) {
  const root = repoRoot()
  const plugRoot = pluginRoot()
  const installed = installedVersion(plugRoot)
  const steps = buildSteps(root)
  const priorRecord = readOnboardRecord(root)
  const priorSteps =
    priorRecord && priorRecord.steps && typeof priorRecord.steps === 'object' ? priorRecord.steps : {}

  const applied = []
  const newTimestamps = {}

  for (const step of steps) {
    if (step.kind !== 'auto' || step.id === 'version-record') continue
    let state
    try {
      state = step.check(installed)
    } catch (err) {
      console.error(`error checking ${step.id}: ${err.message}`)
      return 1
    }
    if (state !== 'pending') continue
    try {
      const detail = step.apply()
      newTimestamps[step.id] = nowIso()
      applied.push({ id: step.id, detail })
    } catch (err) {
      console.error(`error applying ${step.id}: ${err.message}`)
      return 1
    }
  }

  const versionStep = steps.find((s) => s.id === 'version-record')
  const versionState = versionStep.check(installed)
  const needsWrite = versionState === 'pending' || applied.length > 0

  if (!needsWrite) {
    if (json) {
      console.log(JSON.stringify({ applied: [], recorded_version: installed }))
    } else {
      console.log('converged — nothing to apply')
    }
    return 0
  }

  try {
    fs.mkdirSync(path.join(root, '.brigade'), { recursive: true })
    if (versionState === 'pending') {
      newTimestamps['version-record'] = nowIso()
      applied.push({ id: 'version-record', detail: `recorded plugin_version ${installed}` })
    }
    const mergedSteps = { ...priorSteps, ...newTimestamps }
    const record = {
      schema: 1,
      plugin_version: installed,
      updated_at: nowIso(),
      steps: mergedSteps,
    }
    fs.writeFileSync(onboardRecordPath(root), `${JSON.stringify(record, null, 2)}\n`)
  } catch (err) {
    console.error(`error applying version-record: ${err.message}`)
    return 1
  }

  if (json) {
    console.log(JSON.stringify({ applied, recorded_version: installed }))
  } else {
    for (const a of applied) console.log(`applied ${a.id}: ${a.detail}`)
  }
  return 0
}

// Runs a git subcommand for its exit status only (no output we care about) — true if
// it succeeded, false on any failure. Used for existence checks like "does this ref
// exist" or "is there an origin remote", where the exit code IS the answer.
function gitOk(root, args) {
  try {
    execFileSync('git', args, { cwd: root, stdio: 'ignore' })
    return true
  } catch {
    return false
  }
}

// Runs a git subcommand and returns its trimmed stdout, or null on any failure —
// missing repo, no such ref, git not installed, whatever. Every caller treats null as
// "couldn't tell" and falls back, so a git call here can never crash detect.
function gitOut(root, args) {
  try {
    return execFileSync('git', args, { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
  } catch {
    return null
  }
}

// The repo's main branch: prefer what origin's HEAD actually points at, since that's
// the branch PRs land on. Falling back to a local guess only happens for repos with no
// (or no reachable) origin — try main, then master, then just say main since that's
// the more common default in new repos.
function detectMainBranch(root) {
  const symbolic = gitOut(root, ['symbolic-ref', '--short', 'refs/remotes/origin/HEAD'])
  if (symbolic) {
    return symbolic.startsWith('origin/') ? symbolic.slice('origin/'.length) : symbolic
  }
  if (gitOk(root, ['show-ref', '--verify', '--quiet', 'refs/heads/main'])) return 'main'
  if (gitOk(root, ['show-ref', '--verify', '--quiet', 'refs/heads/master'])) return 'master'
  return 'main'
}

// Whether this repo has a remote to open a PR against — true iff `origin` resolves to
// a URL at all, regardless of what kind (https, ssh, even a local file:// path in tests).
function detectRemotePr(root) {
  return gitOk(root, ['remote', 'get-url', 'origin'])
}

// Which file the repo already uses for agent instructions, if any. AGENTS.md wins when
// both exist since it's the more specific, agent-facing name.
function detectAgentsFile(root) {
  if (fs.existsSync(path.join(root, 'AGENTS.md'))) return 'AGENTS.md'
  if (fs.existsSync(path.join(root, 'CLAUDE.md'))) return 'CLAUDE.md'
  return null
}

function readPackageJson(root) {
  try {
    return JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'))
  } catch {
    return null
  }
}

// The gate candidates the onboarding skill offers to the operator as "here's what
// looks like your verification command", cheapest signal first: package.json scripts,
// then Makefile targets, then this repo's own regression runner. Deduped by the
// literal command (so a Makefile `test:` target after an `npm test` script doesn't show
// up twice), capped at 8 so the interview stays skimmable.
function detectGateCandidates(root) {
  const candidates = []
  const seen = new Set()
  const add = (cmd, source) => {
    if (seen.has(cmd)) return
    seen.add(cmd)
    candidates.push({ cmd, source })
  }

  const pkg = readPackageJson(root)
  const scripts = pkg && typeof pkg.scripts === 'object' && pkg.scripts !== null ? pkg.scripts : {}
  for (const name of ['test', 'lint', 'typecheck', 'types', 'check', 'build']) {
    if (Object.prototype.hasOwnProperty.call(scripts, name)) {
      add(name === 'test' ? 'npm test' : `npm run ${name}`, `package.json:scripts.${name}`)
    }
  }

  let makefileText = null
  try {
    makefileText = fs.readFileSync(path.join(root, 'Makefile'), 'utf8')
  } catch {
    makefileText = null
  }
  if (makefileText) {
    for (const line of makefileText.split('\n')) {
      const match = line.match(/^(test|lint|check|build):/)
      if (match) add(`make ${match[1]}`, 'Makefile')
    }
  }

  const gatePath = path.join(root, 'test', 'regression.sh')
  let executable = false
  try {
    fs.accessSync(gatePath, fs.constants.X_OK)
    executable = fs.statSync(gatePath).isFile()
  } catch {
    executable = false
  }
  if (executable) add('./test/regression.sh', 'test/regression.sh')

  return candidates.slice(0, 8)
}

// Read-only repo-signal detection: never writes anything, every underlying check is
// wrapped so a git failure or missing file just falls back instead of crashing.
function runDetect(json) {
  const root = repoRoot()
  const mainBranch = detectMainBranch(root)
  const remotePr = detectRemotePr(root)
  const agentsFile = detectAgentsFile(root)
  const gateCandidates = detectGateCandidates(root)

  if (json) {
    console.log(JSON.stringify({
      main_branch: mainBranch,
      remote_pr: remotePr,
      agents_file: agentsFile,
      gate_candidates: gateCandidates,
    }))
  } else {
    console.log(`main_branch: ${mainBranch}`)
    console.log(`remote_pr: ${remotePr}`)
    console.log(`agents_file: ${agentsFile ?? '(none)'}`)
    for (const c of gateCandidates) {
      console.log(`gate_candidate: ${c.cmd}  (${c.source})`)
    }
  }
  return 0
}

function main() {
  const args = process.argv.slice(2)
  const json = args.includes('--json')
  const command = args.find((a) => a !== '--json')

  switch (command) {
    case 'status':
      return runStatus(json)
    case 'apply':
      return runApply(json)
    case 'detect':
      return runDetect(json)
    default:
      console.error('usage: brigade-onboard <status|apply|detect> [--json]')
      return 2
  }
}

process.exitCode = main()
