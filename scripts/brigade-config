#!/usr/bin/env node
// brigade-config — resolve the layered brigade configuration, at zero model tokens.
//
// Brigade reads its settings from four layers. Later layers win, key by key, so a
// person can change one thing without restating everything above it:
//
//   1. defaults   built into this file (what brigade does with no config at all)
//   2. global     ~/.brigade/config.json                 personal, every repo
//   3. team       <repo>/brigade.config.json             committed, shared
//   4. local      <repo>/.brigade/config.local.json      personal, this repo, never committed
//
// Prompt and agent overrides use the same four layers, but they STACK instead of
// replacing: every layer that has a file for a name contributes text, appended in
// layer order, so a repo can tighten a global rule without losing it.
//
// Usage:
//   brigade-config resolve [--json]        merged settings (+ where each key came from)
//   brigade-config get <dotted.key>        one value, and which layer set it
//   brigade-config layers [--json]         which layer files exist, in precedence order
//   brigade-config prompts [--json]        override stacks, by name
//   brigade-config prompt <name>           the resolved override text for one name
//   brigade-config doctor [--json]         validate every layer; explain what is wrong
//   brigade-config writing [--json] [--preset <name>]
//                                          the writing rules and checks for each artifact
//
// Exit codes: 0 ok, 1 validation failed (doctor), key not found (get) or unknown
// preset (writing), 2 usage/IO error.
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { execFileSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'

const TIERS = ['three-star', 'two-star', 'one-star']
const PLAN_CHECKS = ['always', 'triggers', 'never']
const SOURCE_TYPES = ['static-file', 'mcp', 'skill', 'command']

// The plugin checkout this script lives in. Preset rule text ships with the plugin,
// so it is found next to the script, not in the repo being worked on.
const PLUGIN_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')

// Writing settings: extra sentences for each kind of artifact brigade writes, plus
// checks a script can run on them. A preset is a named bundle of rule text and
// check defaults.
const WRITING_PRESETS = ['none', 'ste-80']
const WRITING_ARTIFACTS = ['packet', 'plan', 'brief', 'report', 'verdict', 'ticket_comment', 'pr_body']
const isCount = (v) => Number.isInteger(v) && v >= 0
const isBoolean = (v) => typeof v === 'boolean'
const isSentence = (v) => typeof v === 'string' && v.trim() !== ''
// `terms` maps the one approved term to the words that must not stand in for it.
const isTerms = (v) => v !== null && typeof v === 'object' && !Array.isArray(v) &&
  Object.entries(v).every(([term, words]) => term.trim() !== '' && Array.isArray(words) && words.every(isSentence))
// Every check an artifact supports, what a valid value looks like, and the value
// that means "off". Only packets have checks so far.
const WRITING_CHECKS = {
  packet: {
    maxStepWords: { off: 0, valid: isCount, want: 'a whole number, 0 or more (0 turns the check off)' },
    maxDescriptionWords: { off: 0, valid: isCount, want: 'a whole number, 0 or more (0 turns the check off)' },
    oneInstructionPerStep: { off: false, valid: isBoolean, want: 'true or false' },
    vendorNeutral: { off: false, valid: isBoolean, want: 'true or false' },
    terms: { off: {}, valid: isTerms, want: 'an object mapping each approved term to a list of words that must not replace it' },
  },
}
// What turning a preset on fills in before any config layer is read. A layer can
// still set any of these back to 0 or false.
const PRESET_CHECKS = {
  none: {},
  'ste-80': {
    packet: { maxStepWords: 20, maxDescriptionWords: 25, oneInstructionPerStep: true, vendorNeutral: true },
  },
}

// What brigade does when nothing is configured. Every key here is overridable.
const DEFAULTS = {
  tier: 'two-star',
  mainBranch: 'main',
  // The model the session-model handshake expects the Planner to be on for this repo.
  // The Planner is the session, not a subagent, so this is a model alias or full model id
  // (fable | opus | sonnet | haiku | claude-...), NOT an agent type like the models.* keys.
  // null = take the tier's planning row from TIERS.md.
  plannerModel: null,
  maxParallel: 4,
  workingMemory: true,
  gate: [],
  policy: {
    scoutCap: null, // null = take the tier's value from TIERS.md
    planCheck: null,
    retro: null,
    heavyShareWarn: 0.2,
  },
  models: {
    scout: null,
    cook: null,
    cookHeavy: null,
    inspector: null,
    analyst: null,
    design: null,
    steward: null,
    designer: null,
  },
  circuitBreaker: {
    maxLadderExhausts: 2,
    maxTotalFails: 4,
  },
  graphite: {
    restack: false,
    platform: false,
  },
  kb: {
    enabled: false,
    cli: null,
    search_args: [],
    ingest_args: [],
  },
  worktreeRoot: null, // null = <repo>/.brigade/worktrees
  remotePr: true,
  contextSources: [],
  review: {
    dimensions: [], // empty = ship the workflow's built-in defaults; layers only override
  },
  prompts: {}, // name -> { append: [...text] }
  writing: {
    preset: 'none',
    rules: Object.fromEntries(WRITING_ARTIFACTS.map((artifact) => [artifact, []])),
    checks: Object.fromEntries(Object.entries(WRITING_CHECKS).map(([artifact, checks]) =>
      [artifact, Object.fromEntries(Object.entries(checks).map(([name, check]) => [name, check.off]))])),
  },
}

const KNOWN_TOP_LEVEL = new Set(Object.keys(DEFAULTS))

// --- layer discovery ---------------------------------------------------------

function repoRoot() {
  const explicit = process.env.BRIGADE_PROJECT_DIR || process.env.CLAUDE_PROJECT_DIR ||
    process.env.CODEX_PROJECT_DIR
  if (explicit) return path.resolve(explicit)
  let cursor = process.cwd()
  while (true) {
    if (fs.existsSync(path.join(cursor, '.brigade'))) return cursor
    const parent = path.dirname(cursor)
    if (parent === cursor) break
    cursor = parent
  }
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], {
      cwd: process.cwd(),
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim()
  } catch {
    return process.cwd()
  }
}

function layerFiles() {
  const root = repoRoot()
  const home = process.env.BRIGADE_HOME || path.join(os.homedir(), '.brigade')
  return [
    { name: 'defaults', file: null, overrideDir: null },
    { name: 'global', file: path.join(home, 'config.json'), overrideDir: path.join(home, 'overrides') },
    { name: 'team', file: path.join(root, 'brigade.config.json'), overrideDir: path.join(root, '.brigade-overrides') },
    { name: 'local', file: path.join(root, '.brigade', 'config.local.json'), overrideDir: path.join(root, '.brigade', 'overrides') },
  ]
}

function readLayer(layer) {
  if (!layer.file) return { ...layer, present: false, data: DEFAULTS, error: null }
  if (!fs.existsSync(layer.file)) return { ...layer, present: false, data: {}, error: null }
  try {
    const raw = fs.readFileSync(layer.file, 'utf8')
    const data = JSON.parse(raw)
    if (data === null || typeof data !== 'object' || Array.isArray(data)) {
      return { ...layer, present: true, data: {}, error: 'top level must be a JSON object' }
    }
    return { ...layer, present: true, data, error: null }
  } catch (err) {
    return { ...layer, present: true, data: {}, error: `unreadable JSON: ${err.message}` }
  }
}

// --- merge -------------------------------------------------------------------

const isPlainObject = (v) => v !== null && typeof v === 'object' && !Array.isArray(v)

// Merge one layer into the accumulator, recording which layer set each leaf so
// `resolve` and `get` can always answer "where did this come from".
function mergeLayer(target, provenance, source, layerName, prefix = '') {
  for (const [key, value] of Object.entries(source)) {
    const dotted = prefix ? `${prefix}.${key}` : key
    if (key === 'contextSources') {
      target[key] = mergeContextSources(target[key] || [], value, provenance, layerName)
      continue
    }
    if (dotted === 'review.dimensions') {
      target[key] = mergeReviewDimensions(target[key] || [], value, provenance, layerName)
      continue
    }
    if (dotted === 'writing') {
      target[key] = mergeWriting(target[key], value, provenance, layerName)
      continue
    }
    if (isPlainObject(value)) {
      if (!isPlainObject(target[key])) target[key] = {}
      mergeLayer(target[key], provenance, value, layerName, dotted)
      continue
    }
    target[key] = value
    provenance[dotted] = layerName
  }
  return target
}

// Shared shape behind both id-keyed array merges below: a later layer can add,
// disable, or retune one entry by id without restating the whole list. Each
// touched entry gets its own provenance key (`<keyPrefix>.<id>`) so `resolve`
// and `get` can say which layer set it.
function mergeArrayById(current, incoming, provenance, layerName, keyPrefix) {
  if (!Array.isArray(incoming)) return current
  const byId = new Map(current.map((item) => [item.id, item]))
  for (const item of incoming) {
    if (!isPlainObject(item) || !item.id) continue
    const existing = byId.get(item.id)
    byId.set(item.id, existing ? { ...existing, ...item } : item)
    provenance[`${keyPrefix}.${item.id}`] = layerName
  }
  return [...byId.values()]
}

// Context sources merge by id rather than by position: a later layer can disable
// or retune one source without restating the whole list.
function mergeContextSources(current, incoming, provenance, layerName) {
  return mergeArrayById(current, incoming, provenance, layerName, 'contextSources')
}

// Review dimensions merge by id too: a repo can retune one dimension (turn it off,
// swap its lens) without restating the whole set.
function mergeReviewDimensions(current, incoming, provenance, layerName) {
  return mergeArrayById(current, incoming, provenance, layerName, 'review.dimensions')
}

// Writing settings merge by their own rules, because the generic merge would get two
// of them wrong: it replaces arrays (rules must stack) and merges nested objects
// (a later `terms` map must replace the earlier one whole).
//   preset                  a later layer replaces it
//   rules.<artifact>        every layer's sentences are appended, in layer order; no
//                           layer can take away a rule an earlier layer added
//   checks.<artifact>.<key> a later layer replaces it, key by key
// A value doctor would reject is skipped here, so one bad entry never wipes out
// what an earlier layer set.
function mergeWriting(current, incoming, provenance, layerName) {
  const out = {
    preset: current ? current.preset : 'none',
    rules: { ...(current ? current.rules : {}) },
    checks: Object.fromEntries(Object.entries(current ? current.checks : {}).map(([a, c]) => [a, { ...c }])),
  }
  if (!isPlainObject(incoming)) return out
  if (WRITING_PRESETS.includes(incoming.preset)) {
    out.preset = incoming.preset
    provenance['writing.preset'] = layerName
  }
  if (isPlainObject(incoming.rules)) {
    for (const [artifact, list] of Object.entries(incoming.rules)) {
      if (!WRITING_ARTIFACTS.includes(artifact) || !Array.isArray(list)) continue
      out.rules[artifact] = [...(out.rules[artifact] || []), ...list.filter(isSentence).map((r) => r.trim())]
      provenance[`writing.rules.${artifact}`] = layerName
    }
  }
  if (isPlainObject(incoming.checks)) {
    for (const [artifact, values] of Object.entries(incoming.checks)) {
      const known = WRITING_CHECKS[artifact]
      if (!known || !isPlainObject(values)) continue
      out.checks[artifact] = { ...(out.checks[artifact] || {}) }
      for (const [name, value] of Object.entries(values)) {
        if (!known[name] || !known[name].valid(value)) continue
        // Copy terms so a later layer's map replaces this one instead of sharing it.
        out.checks[artifact][name] = name === 'terms' ? JSON.parse(JSON.stringify(value)) : value
        provenance[`writing.checks.${artifact}.${name}`] = layerName
      }
    }
  }
  return out
}

// Put the preset's check defaults underneath the layers and settle the final shape.
// A check key still marked 'defaults' was set by no layer, so the preset fills it;
// anything a layer set, including an explicit 0 or false, wins over the preset.
// `presetOverride` is `writing --preset <name>`: resolve as if a layer had set it.
function finishWriting(merged, provenance, presetOverride) {
  const preset = presetOverride || merged.preset
  if (presetOverride) provenance['writing.preset'] = '--preset'
  const presetChecks = PRESET_CHECKS[preset] || {}
  const checks = {}
  for (const [artifact, known] of Object.entries(WRITING_CHECKS)) {
    checks[artifact] = {}
    for (const name of Object.keys(known)) {
      const dotted = `writing.checks.${artifact}.${name}`
      const fromPreset = (presetChecks[artifact] || {})[name]
      if (provenance[dotted] === 'defaults' && fromPreset !== undefined) {
        checks[artifact][name] = fromPreset
        provenance[dotted] = `preset ${preset}`
      } else {
        checks[artifact][name] = merged.checks[artifact][name]
      }
    }
  }
  return {
    preset,
    // The file may not exist yet; doctor reports that, nothing here fails on it.
    presetFile: preset === 'none' ? null : path.join(PLUGIN_ROOT, 'skills', 'brigade', 'writing', `${preset}.md`),
    rules: Object.fromEntries(WRITING_ARTIFACTS.map((artifact) => [artifact, merged.rules[artifact] || []])),
    checks,
  }
}

function resolveConfig({ preset = null } = {}) {
  const layers = layerFiles().map(readLayer)
  const provenance = {}
  const merged = {}
  for (const layer of layers) {
    const data = layer.name === 'defaults' ? DEFAULTS : layer.data
    mergeLayer(merged, provenance, data, layer.name)
  }
  merged.writing = finishWriting(merged.writing, provenance, preset)
  return { config: merged, provenance, layers }
}

// --- prompt / agent overrides ------------------------------------------------

// Override text stacks across layers. `kinds` is any of 'agents' / 'prompts'; a name maps
// to <overrideDir>/<kind>/<name>.md in any layer that has one.
//
// Layer order is the outer loop: everything a layer contributes lands together, so a more
// specific layer always appends after a less specific one regardless of which
// subdirectory the text came from.
function overrideStack(kinds, name) {
  const wanted = Array.isArray(kinds) ? kinds : [kinds]
  return layerFiles()
    .filter((l) => l.overrideDir)
    .flatMap((l) => wanted.map((kind) => ({ layer: l.name, file: path.join(l.overrideDir, kind, `${name}.md`) })))
    .filter((entry) => fs.existsSync(entry.file))
    .map((entry) => ({ ...entry, text: fs.readFileSync(entry.file, 'utf8').trim() }))
}

function allOverrideNames() {
  const names = { agents: new Set(), prompts: new Set() }
  for (const layer of layerFiles()) {
    if (!layer.overrideDir) continue
    for (const kind of ['agents', 'prompts']) {
      const dir = path.join(layer.overrideDir, kind)
      if (!fs.existsSync(dir)) continue
      for (const file of fs.readdirSync(dir)) {
        if (file.endsWith('.md')) names[kind].add(file.slice(0, -3))
      }
    }
  }
  return { agents: [...names.agents].sort(), prompts: [...names.prompts].sort() }
}

// Inline `prompts: { <name>: { append: [...] } }` from config layers counts as an
// override too, so short additions do not need their own file.
function inlinePromptAppends(config, name) {
  const entry = config.prompts && config.prompts[name]
  if (!entry || !Array.isArray(entry.append)) return []
  return entry.append.filter((t) => typeof t === 'string' && t.trim()).map((t) => t.trim())
}

function resolvedPrompt(name) {
  const { config } = resolveConfig()
  const fileParts = overrideStack(['agents', 'prompts'], name)
  const inline = inlinePromptAppends(config, name).map((text) => ({ layer: 'config', file: null, text }))
  return [...fileParts, ...inline]
}

// --- validation --------------------------------------------------------------

function validate() {
  const problems = []
  const layers = layerFiles().map(readLayer)

  for (const layer of layers) {
    if (layer.error) problems.push({ layer: layer.name, file: layer.file, problem: layer.error })
  }

  const { config, provenance } = resolveConfig()

  for (const key of Object.keys(config)) {
    if (!KNOWN_TOP_LEVEL.has(key)) {
      problems.push({ layer: 'merged', file: null, problem: `unknown top-level key "${key}"` })
    }
  }

  if (config.tier != null && !TIERS.includes(config.tier)) {
    problems.push({ layer: 'merged', file: null, problem: `tier must be one of ${TIERS.join(', ')} (got "${config.tier}")` })
  }
  const planCheck = config.policy && config.policy.planCheck
  if (planCheck != null && !PLAN_CHECKS.includes(planCheck)) {
    problems.push({ layer: 'merged', file: null, problem: `policy.planCheck must be one of ${PLAN_CHECKS.join(', ')} (got "${planCheck}")` })
  }
  if (config.maxParallel != null && (!Number.isInteger(config.maxParallel) || config.maxParallel < 1)) {
    problems.push({ layer: 'merged', file: null, problem: 'maxParallel must be a positive integer' })
  }
  if (config.workingMemory != null && typeof config.workingMemory !== 'boolean') {
    problems.push({ layer: 'merged', file: null, problem: 'workingMemory must be a boolean (true or false)' })
  }
  if (config.gate != null && !Array.isArray(config.gate)) {
    problems.push({ layer: 'merged', file: null, problem: 'gate must be an array of shell commands' })
  }
  if (config.kb && config.kb.enabled && !config.kb.cli) {
    problems.push({ layer: 'merged', file: null, problem: 'kb.enabled is true but kb.cli is not set' })
  }

  // Duplicate ids have to be caught per layer: the merge keys by id, so by the time a
  // layer's list reaches the merged config the second entry has already silently won.
  for (const layer of layers) {
    const sources = layer.data && layer.data.contextSources
    if (!Array.isArray(sources)) continue
    const seenInLayer = new Set()
    for (const source of sources) {
      if (!isPlainObject(source) || !source.id) continue
      if (seenInLayer.has(source.id)) {
        problems.push({ layer: layer.name, file: layer.file, problem: `duplicate contextSources id "${source.id}"` })
      }
      seenInLayer.add(source.id)
    }
  }

  for (const source of config.contextSources || []) {
    if (!source.id) {
      problems.push({ layer: 'merged', file: null, problem: 'every contextSources entry needs an id' })
      continue
    }
    if (source.type && !SOURCE_TYPES.includes(source.type)) {
      problems.push({ layer: 'merged', file: null, problem: `contextSources "${source.id}": type must be one of ${SOURCE_TYPES.join(', ')}` })
    }
    if (source.type === 'static-file' && source.path && !fs.existsSync(path.resolve(repoRoot(), source.path))) {
      problems.push({ layer: 'merged', file: null, problem: `contextSources "${source.id}": path does not exist (${source.path})` })
    }
  }

  // Same reasoning as contextSources above: duplicate ids within one layer are
  // already invisible by the time the merge is done, so this has to run per layer.
  for (const layer of layers) {
    const dims = layer.data && layer.data.review && layer.data.review.dimensions
    if (!Array.isArray(dims)) continue
    const seenInLayer = new Set()
    for (const dim of dims) {
      if (!isPlainObject(dim) || !dim.id) continue
      if (seenInLayer.has(dim.id)) {
        problems.push({ layer: layer.name, file: layer.file, problem: `duplicate review.dimensions id "${dim.id}"` })
      }
      seenInLayer.add(dim.id)
    }
  }

  for (const dim of (config.review && config.review.dimensions) || []) {
    if (!isPlainObject(dim) || typeof dim.id !== 'string' || !dim.id) {
      problems.push({ layer: 'merged', file: null, problem: 'every review.dimensions entry needs a string id' })
      continue
    }
    if (dim.enabled != null && typeof dim.enabled !== 'boolean') {
      problems.push({ layer: 'merged', file: null, problem: `review.dimensions "${dim.id}": enabled must be a boolean` })
    }
    if (dim.title != null && typeof dim.title !== 'string') {
      problems.push({ layer: 'merged', file: null, problem: `review.dimensions "${dim.id}": title must be a string` })
    }
    if (dim.lens != null && typeof dim.lens !== 'string') {
      problems.push({ layer: 'merged', file: null, problem: `review.dimensions "${dim.id}": lens must be a string` })
    }
  }

  // Writing settings are checked per layer, because the merge quietly skips a bad
  // value and the person fixing it needs to know which file holds it.
  for (const layer of layers) {
    if (!layer.file || !isPlainObject(layer.data) || !('writing' in layer.data)) continue
    for (const problem of writingProblems(layer.data.writing)) {
      problems.push({ layer: layer.name, file: layer.file, problem })
    }
  }

  // A preset with no rule text on disk would hand every agent nothing to follow.
  const writing = config.writing
  if (writing.presetFile && !fs.existsSync(writing.presetFile)) {
    const from = provenance['writing.preset']
    const layer = layers.find((l) => l.name === from)
    problems.push({
      layer: from || 'merged',
      file: layer ? layer.file : null,
      problem: `writing.preset "${writing.preset}": the preset's rule text is missing (${writing.presetFile})`,
    })
  }

  return problems
}

// Everything wrong with one layer's `writing` block, each naming its dotted key.
function writingProblems(writing) {
  const problems = []
  if (!isPlainObject(writing)) return ['writing must be an object with preset, rules and checks']
  for (const key of Object.keys(writing)) {
    if (!['preset', 'rules', 'checks'].includes(key)) problems.push(`writing.${key}: unknown key (allowed: preset, rules, checks)`)
  }
  if ('preset' in writing && !WRITING_PRESETS.includes(writing.preset)) {
    problems.push(`writing.preset must be one of ${WRITING_PRESETS.join(', ')} (got ${JSON.stringify(writing.preset)})`)
  }
  if ('rules' in writing) {
    if (!isPlainObject(writing.rules)) {
      problems.push('writing.rules must be an object mapping each artifact to a list of sentences')
    } else {
      for (const [artifact, list] of Object.entries(writing.rules)) {
        const dotted = `writing.rules.${artifact}`
        if (!WRITING_ARTIFACTS.includes(artifact)) {
          problems.push(`${dotted}: unknown artifact (allowed: ${WRITING_ARTIFACTS.join(', ')})`)
        } else if (!Array.isArray(list)) {
          problems.push(`${dotted} must be a list of sentences`)
        } else {
          list.forEach((rule, i) => {
            if (!isSentence(rule)) problems.push(`${dotted}[${i}] must be a non-empty string (got ${JSON.stringify(rule)})`)
          })
        }
      }
    }
  }
  if ('checks' in writing) {
    if (!isPlainObject(writing.checks)) {
      problems.push('writing.checks must be an object mapping each artifact to its checks')
    } else {
      for (const [artifact, values] of Object.entries(writing.checks)) {
        const dotted = `writing.checks.${artifact}`
        const known = WRITING_CHECKS[artifact]
        if (!WRITING_ARTIFACTS.includes(artifact)) {
          problems.push(`${dotted}: unknown artifact (allowed: ${WRITING_ARTIFACTS.join(', ')})`)
        } else if (!known) {
          problems.push(`${dotted}: this artifact has no checks (only ${Object.keys(WRITING_CHECKS).join(', ')} does)`)
        } else if (!isPlainObject(values)) {
          problems.push(`${dotted} must be an object of checks`)
        } else {
          for (const [name, value] of Object.entries(values)) {
            if (!known[name]) {
              problems.push(`${dotted}.${name}: unknown check (allowed: ${Object.keys(known).join(', ')})`)
            } else if (!known[name].valid(value)) {
              problems.push(`${dotted}.${name} must be ${known[name].want} (got ${JSON.stringify(value)})`)
            }
          }
        }
      }
    }
  }
  return problems
}

// --- output ------------------------------------------------------------------

function flatten(value, prefix = '', out = {}) {
  for (const [key, val] of Object.entries(value)) {
    const dotted = prefix ? `${prefix}.${key}` : key
    if (isPlainObject(val)) flatten(val, dotted, out)
    else out[dotted] = val
  }
  return out
}

function getByPath(config, dotted) {
  return dotted.split('.').reduce((acc, key) => (acc == null ? acc : acc[key]), config)
}

function printResolve(json) {
  const { config, provenance, layers } = resolveConfig()
  if (json) {
    console.log(JSON.stringify({ config, provenance, layers: layers.map((l) => ({ layer: l.name, file: l.file, present: l.present })) }, null, 2))
    return
  }
  console.log('## brigade config (merged; "from" is the winning layer)')
  const flat = flatten(config)
  for (const [key, value] of Object.entries(flat)) {
    const from = provenance[key] || 'defaults'
    console.log(`  ${key} = ${JSON.stringify(value)}   [${from}]`)
  }
  if ((config.contextSources || []).length) {
    console.log('## context sources')
    for (const source of config.contextSources) {
      const state = source.enabled === false ? 'disabled' : 'enabled'
      console.log(`  ${source.id} (${source.type || 'unknown'}, ${state})   [${provenance[`contextSources.${source.id}`] || 'defaults'}]`)
    }
  }
}

function printLayers(json) {
  const layers = layerFiles().map(readLayer).map((l) => ({
    layer: l.name,
    file: l.file,
    present: l.present,
    overrideDir: l.overrideDir,
    overrideDirPresent: l.overrideDir ? fs.existsSync(l.overrideDir) : false,
    error: l.error,
  }))
  if (json) {
    console.log(JSON.stringify({ layers }, null, 2))
    return
  }
  console.log('## config layers (later wins)')
  for (const l of layers) {
    const mark = l.file === null ? 'built in' : l.present ? 'found' : 'absent'
    console.log(`  ${l.layer.padEnd(8)} ${mark.padEnd(8)} ${l.file || '(defaults in brigade-config)'}`)
    if (l.overrideDir) {
      console.log(`  ${''.padEnd(8)} overrides ${l.overrideDirPresent ? 'found ' : 'absent '} ${l.overrideDir}`)
    }
    if (l.error) console.log(`  ${''.padEnd(8)} ERROR    ${l.error}`)
  }
}

function printPrompts(json) {
  const names = allOverrideNames()
  const { config } = resolveConfig()
  const inlineNames = Object.keys(config.prompts || {})
  const result = {}
  for (const name of [...new Set([...names.agents, ...names.prompts])].sort()) {
    result[name] = overrideStack(['agents', 'prompts'], name).map((e) => ({ layer: e.layer, file: e.file, lines: e.text.split('\n').length }))
  }
  for (const name of inlineNames) {
    result[name] = (result[name] || []).concat(
      inlinePromptAppends(config, name).map((text) => ({ layer: 'config', file: null, lines: text.split('\n').length })),
    )
  }
  if (json) {
    console.log(JSON.stringify({ overrides: result }, null, 2))
    return
  }
  const entries = Object.entries(result)
  if (!entries.length) {
    console.log('## prompt overrides\n  (none)')
    return
  }
  console.log('## prompt overrides (applied in this order, appended to the shipped text)')
  for (const [name, stack] of entries) {
    console.log(`  ${name}:`)
    for (const entry of stack) console.log(`    ${entry.layer.padEnd(7)} ${entry.file || '(inline in config)'} (${entry.lines} lines)`)
  }
}

function printPrompt(name) {
  const stack = resolvedPrompt(name)
  if (!stack.length) return
  for (const entry of stack) {
    console.log(`<!-- brigade override: ${entry.layer}${entry.file ? ` ${entry.file}` : ''} -->`)
    console.log(entry.text)
    console.log('')
  }
}

function printDoctor(json) {
  const problems = validate()
  if (json) {
    console.log(JSON.stringify({ ok: problems.length === 0, problems }, null, 2))
  } else if (!problems.length) {
    console.log('brigade-config: all layers valid')
  } else {
    for (const p of problems) console.error(`brigade-config: [${p.layer}] ${p.problem}${p.file ? ` (${p.file})` : ''}`)
  }
  return problems.length === 0 ? 0 : 1
}

function printGet(dotted, json) {
  const { config, provenance } = resolveConfig()
  const value = getByPath(config, dotted)
  if (value === undefined) {
    console.error(`brigade-config: no such key "${dotted}"`)
    return 1
  }
  if (json) console.log(JSON.stringify({ key: dotted, value, from: provenance[dotted] || 'defaults' }, null, 2))
  else console.log(typeof value === 'string' ? value : JSON.stringify(value))
  return 0
}

// The writing rules and checks that apply in this repo. `--json` prints exactly the
// resolved `writing` settings, the same object `resolve --json` carries.
// The merge skips a bad value, so a broken layer would otherwise vanish without a word:
// each layer with a bad `writing` block gets one stderr line, in doctor's words. Stdout
// and the exit code stay as they are, so a caller reading the JSON is not broken.
function printWriting(json, preset) {
  if (preset !== null && !WRITING_PRESETS.includes(preset)) {
    console.error(`brigade-config: unknown preset "${preset}" (allowed: ${WRITING_PRESETS.join(', ')})`)
    return 1
  }
  const { config, layers } = resolveConfig({ preset })
  for (const layer of layers) {
    if (!layer.file || !isPlainObject(layer.data) || !('writing' in layer.data)) continue
    const problems = writingProblems(layer.data.writing)
    if (problems.length) console.error(`brigade-config: [${layer.name}] ${problems.join('; ')} (${layer.file})`)
  }
  const writing = config.writing
  if (json) {
    console.log(JSON.stringify(writing, null, 2))
    return 0
  }
  const missing = writing.presetFile && !fs.existsSync(writing.presetFile) ? ' (missing)' : ''
  console.log(`## writing (preset: ${writing.preset}${writing.presetFile ? `, rule text ${writing.presetFile}${missing}` : ''})`)
  const withRules = WRITING_ARTIFACTS.filter((artifact) => writing.rules[artifact].length)
  if (!withRules.length) console.log('  rules: (none)')
  for (const artifact of withRules) {
    console.log(`  rules.${artifact}: ${writing.rules[artifact].map((rule) => JSON.stringify(rule)).join(' ')}`)
  }
  for (const [artifact, checks] of Object.entries(writing.checks)) {
    const shown = Object.entries(checks).map(([name, value]) => `${name}=${JSON.stringify(value)}`).join(', ')
    console.log(`  checks.${artifact}: ${shown}`)
  }
  return 0
}

// --- entry point -------------------------------------------------------------

const argv = process.argv.slice(2)
const json = argv.includes('--json')
// `--preset` takes a value, so pull it (and its value) out before reading positionals.
let presetFlag = null
const rest = []
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--preset') {
    presetFlag = argv[i + 1] === undefined ? '' : argv[i + 1]
    i++
  } else if (argv[i].startsWith('--preset=')) {
    presetFlag = argv[i].slice('--preset='.length)
  } else {
    rest.push(argv[i])
  }
}
const positional = rest.filter((a) => !a.startsWith('--'))
const command = positional[0] || 'resolve'

switch (command) {
  case 'resolve':
    printResolve(json)
    break
  case 'layers':
    printLayers(json)
    break
  case 'prompts':
    printPrompts(json)
    break
  case 'prompt':
    if (!positional[1]) {
      console.error('usage: brigade-config prompt <name>')
      process.exit(2)
    }
    printPrompt(positional[1])
    break
  case 'get':
    if (!positional[1]) {
      console.error('usage: brigade-config get <dotted.key>')
      process.exit(2)
    }
    process.exit(printGet(positional[1], json))
    break
  case 'doctor':
    process.exit(printDoctor(json))
    break
  case 'writing':
    if (presetFlag === '') {
      console.error('usage: brigade-config writing [--json] [--preset <name>]')
      process.exit(2)
    }
    // exitCode rather than exit(): on macOS a pipe is written asynchronously, and a
    // hard exit could cut off a long rule list before the reader sees it.
    process.exitCode = printWriting(json, presetFlag)
    break
  default:
    console.error(`brigade-config: unknown command "${command}"`)
    console.error('commands: resolve | get <key> | layers | prompts | prompt <name> | doctor | writing')
    process.exit(2)
}
