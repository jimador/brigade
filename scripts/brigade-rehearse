#!/usr/bin/env node
// brigade-rehearse — runs the pipeline's own mechanical checks over a whole plan before anything
// is dispatched, so a wrong packet premise or a scope clash shows up while it is still cheap to
// fix. It cooks nothing and changes nothing. The checks:
//
//   validate  every FAIL from `brigade-validate <PLAN.md>`
//   premise   a path a packet marks (edit) is missing at the base, or one it marks (create)
//             already exists there (unmarked paths count as edit; done items are skipped)
//   owner     a non-contract item lists a path a contract item lists (the brigade-scope rule)
//   overlap   two items with no dependency path between them list the same file
//   chain     a file listed by three or more items (a warning: it serializes the plan)
//   risk      `brigade-risk` says an item escalates but the item is not `heavy: true`
//   pin       test files the item does not list mention a file it edits (a warning: the cook
//             may have to change behavior those tests pin); files it creates are not counted
//   premise FAIL       a packet's `- **premise:** \`<command>\`` line exits non-zero on the base;
//             a trailing `# comment` after the closing backtick is allowed
//   verify UNRUNNABLE  a Verify command fails on the base for a reason the change cannot fix:
//             a `node --check` / `bash -n` that fails there, or a script or program it runs that
//             is missing there and that the packet does not create; what a line needs is looked
//             up right before that line runs, so files the block makes or removes later never
//             count, and an operand counts as an option by its text once quotes are removed
//   verify incomplete  a Verify line never ran because the block ended before it (an `exit`,
//             or the time limit); `set -e` and `set -o errexit` are turned back off after every
//             line, so an expected failure never ends the block
//
// Each finding prints as one line `<check>: <item>: <detail>`; a chain warning prints as
// `chain: <file>: <slugs in order>`, a pin warning as one summary line per item
// `pin: <item>: <n> test files reference its edited files: a, b, c (+k more)`; the last three
// checks print in the shapes their names show. With --json, each prints as one JSON object
// per line.
//
// The premise and Verify commands run in a temporary detached worktree of the base, which is
// reset to the base (tracked changes discarded, untracked and ignored files removed) before
// each packet, so nothing one packet's commands leave behind reaches the next, and removed
// afterwards. Each premise runs in its own shell; each fenced Verify block runs as one script,
// lines in order, so `cd` and variables carry from line to line; a probe before each command
// records what diagnosing it needs and a marker after it records its exit status. Each premise and each block has a 60 s limit.
// --no-exec skips running them and prints `premises: skipped` (to stderr with --json).
//
// Usage:
//   brigade-rehearse <PLAN.md> [--base <ref>] [--json] [--no-exec]
//
// The base defaults to the plan's `delivery_branch`. A fresh dish only creates that branch at
// dispatch, after the plan check, so when it is unset or does not exist yet the base falls back
// to the main line: the configured main branch (`mainBranch` from `brigade-config resolve`, when
// a config layer sets it), then that branch on origin, then origin's default branch, else main,
// else master, else HEAD. The fallback
// prints one `base: <ref> (...)` line (to stderr with --json, so stdout stays JSON). Git runs in
// the current directory, so run it from inside the repository the plan describes.
//
// Exit codes: 0 no findings (warnings allowed), 1 findings, 2 usage or I/O error.
import { execFileSync, spawn, spawnSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { parsePlan } from './lib/plan.mjs'

const HERE = path.dirname(fileURLToPath(import.meta.url))

function usage() {
  console.error('usage: brigade-rehearse <PLAN.md> [--base <ref>] [--json] [--no-exec]')
  return 2
}

// A failure the user has to fix before the rehearsal can say anything (bad ref, a sibling
// script that could not run). main() turns it into exit 2.
class RehearsalError extends Error {}

// Same normal form as brigade-scope: leading `./` stripped, repeated `/` collapsed. A trailing
// `/` survives and still means "everything under this directory".
function normalize(p) {
  let s = p.replace(/\/{2,}/g, '/')
  while (s.startsWith('./')) s = s.slice(2)
  return s
}

// brigade-scope's ownership rule: a directory entry (trailing `/`, or `` for the repo root)
// covers every path under it; any other entry covers exactly itself.
function covers(entry, p) {
  if (entry === '' || entry.endsWith('/')) return p.startsWith(entry)
  return p === entry
}

// Two file-list entries touch the same file when either one covers the other.
function sameFile(a, b) {
  return covers(a, b) || covers(b, a)
}

// Reads the (edit)/(create) marks of every packet. A packet runs from its `## Packet: <slug>`
// heading to the next `## Packet:` heading or the end of the file; inside it, a line
// `- <path> (edit…)` or `- <path> (create…)` marks that path. Fenced code is skipped, as
// parsePlan skips it. The first mark for a path wins.
function packetMarks(text) {
  const marks = new Map()
  let current = null
  let fenced = false
  for (const line of text.replace(/\r\n?/g, '\n').split('\n')) {
    if (/^\s*(```|~~~)/.test(line)) {
      fenced = !fenced
      continue
    }
    if (fenced) continue
    const heading = /^##\s+Packet:\s*(\S+)/.exec(line)
    if (heading) {
      current = heading[1]
      if (!marks.has(current)) marks.set(current, new Map())
      continue
    }
    if (current === null) continue
    const m = /^\s*[-*]\s+`?([^\s`]+)`?\s+\((edit|create)\b[^)]*\)/i.exec(line)
    if (!m) continue
    const p = normalize(m[1])
    const own = marks.get(current)
    if (!own.has(p)) own.set(p, m[2].toLowerCase())
  }
  return marks
}

function git(args) {
  return spawnSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 })
}

function isCommit(ref) {
  return git(['rev-parse', '--verify', '--quiet', `${ref}^{commit}`]).status === 0
}

// The main branch a config layer sets, read through the sibling brigade-config so every layer
// (team, global, local) counts. The built-in default does not count: an unconfigured repo keeps
// the origin/HEAD-first order. Anything that goes wrong here means "no configured branch", so
// the fallback behaves as it did before this lookup existed.
function configuredMainBranch() {
  const r = spawnSync(process.execPath, [path.join(HERE, 'brigade-config'), 'resolve', '--json'],
    { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 16 * 1024 * 1024 })
  if (r.error || r.status !== 0) return null
  let out
  try {
    out = JSON.parse(r.stdout)
  } catch {
    return null
  }
  let value = out?.config?.mainBranch
  if (value !== null && typeof value === 'object') value = value.value
  if (typeof value !== 'string') return null
  value = value.trim()
  // A leading `-` would read as an option to git, so it is not a branch we will try.
  if (value === '' || value.startsWith('-')) return null
  if (out?.provenance?.mainBranch === 'defaults') return null
  return value
}

// The main line to rehearse against when the delivery branch is not there yet: the configured
// main branch, the same branch on origin, the branch origin/HEAD points at, then main, master
// and HEAD, whichever resolves first.
function mainLine() {
  const candidates = []
  const configured = configuredMainBranch()
  if (configured !== null) candidates.push(configured, `origin/${configured}`)
  const originHead = git(['symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD'])
  if (originHead.status === 0 && originHead.stdout.trim() !== '') candidates.push(originHead.stdout.trim())
  candidates.push('main', 'master', 'HEAD')
  return candidates.find(isCommit) ?? null
}

function existsAt(base, p) {
  const r = git(['cat-file', '-e', `${base}:${p.replace(/\/+$/, '')}`])
  return r.status === 0
}

// Every slug an item reaches by following depends_on, however many hops away.
function ancestorsOf(slug, bySlug) {
  const seen = new Set()
  const stack = [...(bySlug.get(slug)?.depends_on ?? [])]
  while (stack.length > 0) {
    const s = stack.pop()
    if (seen.has(s)) continue
    seen.add(s)
    for (const d of bySlug.get(s)?.depends_on ?? []) stack.push(d)
  }
  return seen
}

// Runs a sibling script with Node and hands back its parsed --json output. A spawn failure, an
// unexpected exit code or unparseable output is a RehearsalError: the check could not run, which
// is not the same thing as the check passing.
function runSibling(name, args, okCodes) {
  const script = path.join(HERE, name)
  const r = spawnSync(process.execPath, [script, ...args], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })
  if (r.error) throw new RehearsalError(`could not run ${name}: ${r.error.message}`)
  if (!okCodes.includes(r.status)) {
    const why = (r.stderr || r.stdout || '').trim().split('\n').slice(-3).join(' / ')
    throw new RehearsalError(`${name} exited ${r.status}${why ? `: ${why}` : ''}`)
  }
  try {
    return JSON.parse(r.stdout)
  } catch {
    throw new RehearsalError(`${name} printed output that is not JSON`)
  }
}

// validate: one finding per problem brigade-validate reports. Its --json problems are exactly
// the lines its text mode prints as `FAIL  <file>: <problem>`.
function checkValidate(planPath) {
  const out = runSibling('brigade-validate', ['--json', planPath], [0, 1])
  const found = []
  for (const r of out.results ?? []) {
    for (const problem of r.problems ?? []) {
      found.push({ check: 'validate', item: 'plan', detail: problem })
    }
  }
  return found
}

// premise: (edit) paths must exist at the base, (create) paths must not. One allowance: an edit
// of a path that an ancestor item creates is fine, because that ancestor lands first and the
// file will be there by the time this item is cooked.
function checkPremise(plan, marks, base, bySlug) {
  const found = []
  for (const item of plan.items) {
    if (item.status === 'done') continue
    const own = marks.get(item.slug) ?? new Map()
    let createdUpstream = null
    for (const raw of item.files) {
      const p = normalize(raw)
      if (p === '') continue
      const mark = own.get(p) ?? 'edit'
      const there = existsAt(base, p)
      if (mark === 'create' && there) {
        found.push({ check: 'premise', item: item.slug, path: p,
          detail: `${p} is marked (create) but already exists at ${base}` })
      } else if (mark === 'edit' && !there) {
        if (createdUpstream === null) {
          createdUpstream = new Set()
          for (const a of ancestorsOf(item.slug, bySlug)) {
            for (const [q, m] of marks.get(a) ?? []) if (m === 'create') createdUpstream.add(q)
          }
        }
        if (createdUpstream.has(p)) continue
        const how = own.has(p) ? 'marked (edit)' : 'unmarked (checked as edit)'
        found.push({ check: 'premise', item: item.slug, path: p,
          detail: `${p} is ${how} but does not exist at ${base}` })
      }
    }
  }
  return found
}

// owner: a non-contract item that still has to be cooked may not list a path any contract item
// lists. Contract items are exempt among themselves, as brigade-scope exempts them.
function checkOwner(plan) {
  const found = []
  const contracts = plan.items.filter((it) => it.contract)
  for (const item of plan.items) {
    if (item.contract || item.status === 'done') continue
    for (const raw of item.files) {
      const p = normalize(raw)
      const owner = contracts.find((c) => c.files.some((e) => covers(normalize(e), p)))
      if (owner) {
        found.push({ check: 'owner', item: item.slug, path: p,
          detail: `${p} is owned by contract item ${owner.slug}` })
      }
    }
  }
  return found
}

// overlap: two items still to be cooked, neither reachable from the other through depends_on,
// listing the same file. They could run in parallel and collide.
function checkOverlap(open, bySlug) {
  const found = []
  const ancestors = new Map(open.map((it) => [it.slug, ancestorsOf(it.slug, bySlug)]))
  for (let i = 0; i < open.length; i++) {
    for (let j = i + 1; j < open.length; j++) {
      const a = open[i]
      const b = open[j]
      if (ancestors.get(a.slug).has(b.slug) || ancestors.get(b.slug).has(a.slug)) continue
      const shared = []
      for (const ra of a.files) {
        const pa = normalize(ra)
        if (b.files.some((rb) => sameFile(pa, normalize(rb))) && !shared.includes(pa)) shared.push(pa)
      }
      for (const p of shared) {
        found.push({ check: 'overlap', item: a.slug, path: p, other: b.slug,
          detail: `${p} is also listed by ${b.slug}, and neither depends on the other` })
      }
    }
  }
  return found
}

// Orders items so each comes after everything it depends on, keeping plan order otherwise.
// A cycle (brigade-validate reports those) falls back to plan order for the items caught in it.
function landingOrder(items, bySlug) {
  const order = []
  const placed = new Set()
  const visiting = new Set()
  const visit = (it) => {
    if (placed.has(it.slug) || visiting.has(it.slug)) return
    visiting.add(it.slug)
    for (const d of it.depends_on) if (bySlug.has(d)) visit(bySlug.get(d))
    visiting.delete(it.slug)
    placed.add(it.slug)
    order.push(it)
  }
  for (const it of items) visit(it)
  return order
}

// chain: a warning for each file three or more items still to be cooked list, naming them in the
// order they would land.
function checkChain(open, bySlug) {
  const ordered = landingOrder(open, bySlug).filter((it) => open.includes(it))
  const byFile = new Map()
  for (const it of ordered) {
    for (const raw of it.files) {
      const p = normalize(raw)
      if (!byFile.has(p)) byFile.set(p, [])
      const slugs = byFile.get(p)
      if (!slugs.includes(it.slug)) slugs.push(it.slug)
    }
  }
  const found = []
  for (const [p, slugs] of byFile) {
    if (slugs.length < 3) continue
    found.push({ check: 'chain', level: 'warning', item: p, items: slugs, detail: slugs.join(' -> ') })
  }
  return found
}

// risk: brigade-risk exits 0 whether or not it escalates, so read its --json. An escalating item
// that is not heavy goes to a cook too weak for it.
function checkRisk(open) {
  const found = []
  for (const item of open) {
    if (item.files.length === 0) continue
    const out = runSibling('brigade-risk', ['--json', '--files', ...item.files], [0])
    if (out.escalate !== true || item.heavy) continue
    const why = []
    if (out.threshold_exceeded) why.push(`${out.file_count} files, threshold ${out.file_threshold}`)
    const cats = [...new Set((out.matches ?? []).map((m) => m.category))]
    if (cats.length > 0) why.push(`categories ${cats.join(', ')}`)
    found.push({ check: 'risk', item: item.slug,
      detail: `brigade-risk escalates (${why.join('; ') || 'escalate: true'}) but the item is not heavy: true` })
  }
  return found
}

// pin: the test files that most often pin behavior. A file an item lists is "mentioned" when its
// basename appears as a whole name (so `a.js` is not found inside `data.js` or `a.json`); its
// full path always contains the basename, so one search covers both.
const PIN_PATHS = ['test/regression.sh', 'test/scripts', 'test/board']

function escapeRegExp(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
}

function mentions(text, name) {
  return new RegExp(`(^|[^\\w.-])${escapeRegExp(name)}(?![\\w-])`).test(text)
}

// pin: at most one warning per item, for the test files at the base that the item does not list
// and that mention a file it edits (an (edit) mark, or no mark). A file the item creates is new,
// so no existing test can pin its behavior, and directory entries are skipped. The warning names
// the first three test files in git grep's order and counts the rest.
function checkPin(open, base, marks) {
  const found = []
  for (const item of open) {
    const own = marks.get(item.slug) ?? new Map()
    const files = [...new Set(item.files.map(normalize))]
      .filter((p) => p !== '' && !p.endsWith('/') && (own.get(p) ?? 'edit') === 'edit')
    if (files.length === 0) continue
    const args = ['grep', '-n', '-I', '-F']
    for (const name of new Set(files.map((p) => path.posix.basename(p)))) args.push('-e', name)
    const r = git([...args, base, '--', ...PIN_PATHS])
    if (r.status === 1) continue
    if (r.status !== 0) throw new RehearsalError(`git grep for pinning tests failed: ${r.stderr.trim()}`)
    const tests = []
    const paths = []
    const prefix = `${base}:`
    for (const row of r.stdout.split('\n')) {
      if (!row.startsWith(prefix)) continue
      const m = /^(.*?):(\d+):(.*)$/.exec(row.slice(prefix.length))
      if (!m) continue
      const [, testFile, , body] = m
      if (item.files.some((e) => covers(normalize(e), testFile))) continue
      for (const p of files) {
        if (!mentions(body, path.posix.basename(p))) continue
        if (!tests.includes(testFile)) tests.push(testFile)
        if (!paths.includes(p)) paths.push(p)
      }
    }
    if (tests.length === 0) continue
    const more = tests.length > 3 ? ` (+${tests.length - 3} more)` : ''
    found.push({ check: 'pin', level: 'warning', item: item.slug, tests, paths,
      detail: `${tests.length} test files reference its edited files: ${tests.slice(0, 3).join(', ')}${more}` })
  }
  return found
}

// The raw lines of each packet, from its `## Packet: <slug>` heading to the next one.
function packetSections(text) {
  const sections = new Map()
  let current = null
  let fenced = false
  for (const line of text.replace(/\r\n?/g, '\n').split('\n')) {
    if (/^\s*(```|~~~)/.test(line)) fenced = !fenced
    else if (!fenced) {
      const heading = /^##\s+Packet:\s*(\S+)/.exec(line)
      if (heading) {
        current = heading[1]
        if (!sections.has(current)) sections.set(current, [])
        continue
      }
    }
    if (current !== null) sections.get(current).push(line)
  }
  return sections
}

// Every `- **premise:** `<command>`` line outside fenced code. A `# comment` may follow the
// closing backtick, as in the packet template's example; the shortest command that leaves only
// such a comment behind wins, so a backtick inside the comment does not end the command.
function packetPremises(lines) {
  const out = []
  let fenced = false
  for (const line of lines) {
    if (/^\s*(```|~~~)/.test(line)) {
      fenced = !fenced
      continue
    }
    if (fenced) continue
    const m = /^\s*[-*]\s+\*\*premise:\*\*\s*`(.+?)`\s*(?:#.*)?$/i.exec(line)
    if (m && m[1].trim() !== '') out.push(m[1].trim())
  }
  return out
}

// The commands of one fenced shell block: blank and comment lines dropped, `\` continuations
// and heredoc bodies kept with the line that starts them.
function blockCommands(block) {
  const out = []
  let pending = ''
  let heredoc = null
  for (const raw of block) {
    const line = raw.trim()
    if (heredoc !== null) {
      pending += `\n${line}`
      if (line === heredoc) {
        out.push(pending)
        pending = ''
        heredoc = null
      }
      continue
    }
    if (pending === '' && (line === '' || line.startsWith('#'))) continue
    pending = pending === '' ? line : `${pending}\n${line}`
    if (line.endsWith('\\')) continue
    const h = /<<-?\s*(['"]?)([A-Za-z_]\w*)\1/.exec(line.replace(/<<</g, ''))
    if (h) {
      heredoc = h[2]
      continue
    }
    out.push(pending)
    pending = ''
  }
  if (pending !== '') out.push(pending)
  return out
}

// A Verify step: a heading, a list item or a bold label that starts with "Verify".
const VERIFY_STEP = /^(\s*)(?:(#{1,6})\s+\**|(?:\d+[.)]|[-*])\s+\**|\*\*)\s*Verify\b/i

// The fenced bash/sh blocks under the packet's Verify step, each as its list of commands. Under a
// heading the step runs to the next heading; under a list item it also ends at the next item at
// the same or a shallower indent.
function verifyBlocks(lines) {
  const blocks = []
  let fence = null
  let region = null
  let block = []
  for (const line of lines) {
    const f = /^\s*(```|~~~)\s*([^\s`]*)/.exec(line)
    if (fence !== null) {
      if (f && f[1] === fence.marker && f[2] === '') {
        if (fence.shell) {
          const commands = blockCommands(block)
          if (commands.length > 0) blocks.push(commands)
        }
        fence = null
      } else if (fence.shell) block.push(line)
      continue
    }
    if (f) {
      fence = { marker: f[1], shell: region !== null && /^(bash|sh|shell)$/i.test(f[2]) }
      block = []
      continue
    }
    const v = VERIFY_STEP.exec(line)
    if (v) {
      region = { heading: Boolean(v[2]), indent: v[1].length }
      continue
    }
    if (region === null) continue
    if (/^\s*#{1,6}\s/.test(line)) region = null
    else if (!region.heading) {
      const item = /^(\s*)(?:\d+[.)]|[-*])\s/.exec(line)
      if (item && item[1].length <= region.indent) region = null
    }
  }
  return blocks
}

// The end (exclusive) of a `$( )`, `${ }` or backtick expansion starting at i.
function expansionEnd(line, i) {
  if (line[i] === '`') {
    const e = line.indexOf('`', i + 1)
    return e === -1 ? line.length : e + 1
  }
  if (line[i + 1] === '{') {
    const e = line.indexOf('}', i + 2)
    return e === -1 ? line.length : e + 1
  }
  let depth = 0
  for (let j = i + 1; j < line.length; j++) {
    if (line[j] === '(') depth++
    else if (line[j] === ')' && --depth === 0) return j + 1
  }
  return line.length
}

const REDIRECT = /^(&>>|&>|<<<|<<-|<<|<>|>>|>&|<&|>\||>|<)/

// Splits a shell command into simple commands: [{ words, text }], each word
// { text, quoted, dynamic, redirect }. It knows quotes, escapes, expansions, comments, control
// operators, redirections and heredoc bodies; enough for the static checks, not a full shell.
function simpleCommands(line) {
  const commands = []
  let words = []
  let word = null
  let start = 0
  let redirect = null
  let heredocs = []
  const open = () => (word ??= { text: '', quoted: false, dynamic: false, redirect: null })
  const endWord = () => {
    if (word === null) return
    if (redirect !== null) {
      word.redirect = redirect
      if (redirect.startsWith('<<') && redirect !== '<<<') heredocs.push(word.text)
      redirect = null
    }
    words.push(word)
    word = null
  }
  const endCommand = (at, next) => {
    endWord()
    if (words.length > 0) commands.push({ words, text: line.slice(start, at).trim() })
    words = []
    start = next
    redirect = null
  }
  let i = 0
  while (i < line.length) {
    const c = line[i]
    if (c === '\\') {
      if (line[i + 1] === '\n') endWord()
      else open().text += line[i + 1] ?? ''
      i += 2
      continue
    }
    if (c === "'" || c === '"') {
      let end = line.indexOf(c, i + 1)
      if (end === -1) end = line.length
      const w = open()
      const body = line.slice(i + 1, end)
      w.quoted = true
      if (c === '"' && /[$`]/.test(body)) w.dynamic = true
      w.text += body
      i = end + 1
      continue
    }
    if (c === '`' || c === '$') {
      const end = c === '$' && line[i + 1] !== '(' && line[i + 1] !== '{' ? i + 1 : expansionEnd(line, i)
      const w = open()
      w.dynamic = true
      w.text += line.slice(i, end)
      i = end
      continue
    }
    if (c === '#' && word === null) {
      const e = line.indexOf('\n', i)
      i = e === -1 ? line.length : e
      continue
    }
    if (c === '\n') {
      endCommand(i, i + 1)
      i++
      // Skip heredoc bodies up to their delimiter lines.
      while (heredocs.length > 0 && i < line.length) {
        let e = line.indexOf('\n', i)
        if (e === -1) e = line.length
        if (line.slice(i, e).trim() === heredocs[0]) heredocs.shift()
        i = e + 1
      }
      heredocs = []
      start = Math.min(i, line.length)
      continue
    }
    if (c === ' ' || c === '\t') {
      endWord()
      i++
      continue
    }
    const r = REDIRECT.exec(line.slice(i))
    if (r && (c !== '&' || r[1].startsWith('&>'))) {
      if (word !== null && !word.quoted && /^\d+$/.test(word.text)) word = null
      else endWord()
      i += r[1].length
      if (r[1] === '>&' || r[1] === '<&') {
        const fd = /^\s*[\d-]+/.exec(line.slice(i))
        if (fd) i += fd[0].length
      } else redirect = r[1]
      continue
    }
    if (c === ';' || c === '|' || c === '&' || c === '(' || c === ')') {
      // A subshell or a function definition: the commands inside are not at the top level.
      if (c === '(' || c === ')') commands.grouped = true
      let j = i + 1
      if (c !== '(' && c !== ')') while (j < line.length && /[;|&]/.test(line[j])) j++
      endCommand(i, j)
      i = j
      continue
    }
    open().text += c
    i++
  }
  endCommand(line.length, line.length)
  return commands
}

const SHELL_WORDS = new Set(['if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until', '!', '{', '}',
  'in', 'esac'])
const WRAPPERS = new Set(['env', 'exec', 'command', 'nohup', 'time', 'xargs'])
// Segments whose words are not a program and its arguments, or whose program comes from a
// package registry rather than the tree.
const OPAQUE = new Set(['for', 'case', 'select', 'function', 'npx', 'bunx', 'pnpx'])
// The shells whose script operand is checked, and whose `-n` is a syntax check.
const SHELLS = new Set(['bash', 'sh'])
const NODE_INLINE = new Set(['-e', '-p', '--eval', '--print'])
// Words that open, continue or close an if, a loop, a case, a brace group or a function. A unit
// with one of them leading a command is compound, and rehearsal does not probe it.
const COMPOUND = new Set(['if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until', 'for', 'case',
  'esac', 'select', 'function', '{', '}'])
// Programs that read and never write, so a command after one of them in the same unit still sees
// the files the probe saw.
const READ_ONLY = new Set(['echo', 'printf', 'test', '[', '[[', 'true', 'false', ':', 'cat', 'grep', 'egrep',
  'fgrep', 'rg', 'ls', 'head', 'tail', 'wc', 'diff', 'cmp', 'stat', 'pwd', 'which', 'type'])
const GIT_READ_ONLY = new Set(['diff', 'status', 'log', 'show', 'rev-parse', 'ls-files', 'grep'])
const OUTPUT_REDIRECTS = new Set(['>', '>>', '>|', '&>', '&>>', '<>'])
const DEVICES = new Set(['/dev/null', '/dev/stdout', '/dev/stderr'])
const NODE_VALUE_OPTIONS = new Set(['-r', '--require', '--import', '--loader', '--experimental-loader',
  '-C', '--conditions', '--input-type', '--env-file', '--title', '--watch-path', '--test-name-pattern',
  '--test-skip-pattern', '--test-reporter', '--test-reporter-destination', '--test-concurrency',
  '--test-timeout', '--test-shard', '--test-coverage-include', '--test-coverage-exclude'])
const SHELL_VALUE_OPTIONS = new Set(['-o', '+o', '-O', '+O'])

// The program word and its argument words of a simple command, past assignments, shell
// keywords and wrappers. 'stop' for cd/pushd (later relative paths no longer mean the tree);
// null when there is nothing to check.
function commandParts(words) {
  const plain = (w) => !w.quoted && !w.dynamic
  let k = 0
  while (k < words.length && (words[k].redirect !== null ||
    (plain(words[k]) && (/^[A-Za-z_]\w*=/.test(words[k].text) || SHELL_WORDS.has(words[k].text))))) k++
  if (k >= words.length || words[k].dynamic) return null
  let program = words[k]
  if (plain(program) && (program.text === 'cd' || program.text === 'pushd')) return 'stop'
  if (OPAQUE.has(program.text)) return null
  if (WRAPPERS.has(program.text)) {
    k++
    while (k < words.length && (words[k].redirect !== null ||
      (plain(words[k]) && (words[k].text.startsWith('-') || /^[A-Za-z_]\w*=/.test(words[k].text))))) k++
    if (k >= words.length || words[k].dynamic) return null
    program = words[k]
  }
  return { program: program.text, args: words.slice(k + 1).filter((w) => w.redirect === null) }
}

// An operand whose text is a literal path: nothing the shell would expand (`$`, backticks) and
// no glob characters. Quotes are already gone from the word's text.
function literalOperand(w) {
  return !w.dynamic && w.text !== '' && !/[$`*?[]/.test(w.text)
}

// The operands a simple command executes, which are the only words checked as files: the script
// of `node` (every test path under `node --test`), the script of `bash` or `sh`. Every other
// argument, a search pattern included, is never treated as a file, and the program itself is
// checked by the caller. Words are judged by their text once the quotes are gone, the way the
// program sees them, so `"--test-name-pattern=two words"` is an option like its unquoted form.
function fileArgs(program, args) {
  const name = path.posix.basename(program)
  const operands = args.filter((a) => a.redirect === null)
  const option = (a) => /^[-+]./.test(a.text)
  const out = []
  if (name === 'node') return nodeCommand(operands)?.files ?? []
  if (SHELLS.has(name)) {
    // `-c` (alone or in a flag cluster such as `-ec`) runs a string, and `-s` reads stdin.
    if (operands.some((a) => !a.dynamic && /^-[A-Za-z]*[cs][A-Za-z]*$/.test(a.text))) return []
    let skipNext = false
    for (const a of operands) {
      if (skipNext) {
        skipNext = false
        continue
      }
      if (option(a)) {
        if (SHELL_VALUE_OPTIONS.has(a.text)) skipNext = true
        continue
      }
      if (literalOperand(a)) out.push(a.text)
      break
    }
  }
  return out
}

// Reads node's arguments the way node does, left to right: options until the first other word or
// `--`, an option that takes a value eating the next word whatever it looks like, and then the
// script, whose own arguments follow it (under `--test`, the test files). Returns node's options
// and the files it runs, or null when it cannot tell: inline code, an expansion where an option
// could be, or a cluster of short flags.
function nodeCommand(operands) {
  const options = []
  let i = 0
  for (; i < operands.length; i++) {
    const a = operands[i]
    if (a.dynamic) return null
    if (a.text === '--') {
      i++
      break
    }
    if (!/^-./.test(a.text)) break
    if (NODE_INLINE.has(a.text) || /^--(eval|print)=/.test(a.text) || /^-[A-Za-z]{2,}$/.test(a.text)) return null
    options.push(a.text)
    if (NODE_VALUE_OPTIONS.has(a.text)) i++
  }
  const rest = operands.slice(i)
  const files = []
  if (!options.includes('--test')) {
    if (rest.length > 0 && literalOperand(rest[0])) files.push(rest[0].text)
    return { options, files }
  }
  let skipNext = false
  for (const a of rest) {
    if (skipNext) {
      skipNext = false
      continue
    }
    if (/^[-+]./.test(a.text)) {
      if (NODE_VALUE_OPTIONS.has(a.text)) skipNext = true
      continue
    }
    if (literalOperand(a)) files.push(a.text)
  }
  return { options, files }
}

// `node --check` / `bash -n` segments: what they check, and how to name them.
function syntaxCheck(seg) {
  const parts = commandParts(seg.words)
  if (parts === null || parts === 'stop') return null
  const name = path.posix.basename(parts.program)
  // A rerun in a fresh shell would not see the block's variables, so such a segment is left alone.
  if (seg.words.some((w) => w.dynamic)) return null
  const flags = parts.args.map((a) => a.text)
  if (name === 'node') {
    // Only node's own options count: `node script.mjs --check` passes --check to the script.
    const n = nodeCommand(parts.args)
    if (n === null || !(n.options.includes('--check') || n.options.includes('-c'))) return null
    return { label: 'node --check', targets: n.files }
  }
  if (SHELLS.has(name) && flags.includes('-n')) return { label: `${name} -n`, targets: fileArgs(parts.program, parts.args) }
  return null
}

const EXEC_TIMEOUT_MS = 60 * 1000

// Runs a command with bash in `cwd`, its own process group, no stdin and no output, killing the
// whole group when it exits or when the time limit runs out.
function runShell(command, cwd) {
  return new Promise((resolve) => {
    let timedOut = false
    let child
    try {
      child = spawn('bash', ['-c', command], { cwd, stdio: 'ignore', detached: true })
    } catch (err) {
      resolve({ status: 127, signal: null, timedOut: false })
      return
    }
    const killGroup = () => {
      try {
        process.kill(-child.pid, 'SIGKILL')
      } catch {
        // The group is already gone.
      }
    }
    const timer = setTimeout(() => {
      timedOut = true
      killGroup()
    }, EXEC_TIMEOUT_MS)
    child.on('error', () => {
      clearTimeout(timer)
      resolve({ status: 127, signal: null, timedOut: false })
    })
    child.on('exit', (code, signal) => {
      clearTimeout(timer)
      killGroup()
      resolve({ status: code, signal, timedOut })
    })
  })
}

function exitText(r) {
  if (r.timedOut) return `exit 124, timed out after ${EXEC_TIMEOUT_MS / 1000} s`
  return r.status !== null ? `exit ${r.status}` : `exit ${r.signal}`
}

// Runs fn(worktree) inside a temporary detached worktree of base, always removing it after. The
// worktree path has symlinks resolved, so the directories the shell reports compare with it.
async function withBaseWorktree(base, fn) {
  const top = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'brigade-rehearse-base-')))
  const wt = path.join(top, 'base')
  const add = git(['worktree', 'add', '--detach', wt, base])
  if (add.status !== 0) {
    fs.rmSync(top, { recursive: true, force: true })
    throw new RehearsalError(`could not create a worktree of ${base}: ${add.stderr.trim()}`)
  }
  try {
    return await fn(wt)
  } finally {
    git(['worktree', 'remove', '--force', '--force', wt])
    fs.rmSync(top, { recursive: true, force: true })
    git(['worktree', 'prune'])
  }
}

// Puts the worktree back to exactly the base commit: HEAD, index and tracked files reset, and
// every untracked or ignored file removed, so one packet's commands cannot satisfy or break the
// next packet's premises and Verify block.
function resetWorktree(wt, commit) {
  for (const args of [['checkout', '-q', '--force', '--detach', commit], ['reset', '-q', '--hard', commit],
    ['clean', '-q', '-ffdx']]) {
    const r = git(['-C', wt, ...args])
    if (r.status !== 0) throw new RehearsalError(`could not reset the base worktree: git ${args[0]}: ${r.stderr.trim()}`)
  }
}

// True when bash can parse the text on its own.
function parses(text) {
  return spawnSync('bash', ['-n', '-c', text], { stdio: 'ignore' }).status === 0
}

// The block's commands joined into units bash can parse on their own: a command that opens an
// `if`, a loop, a `case` or a trailing pipe takes the following commands until it closes, so a
// marker is never put inside a compound command.
function blockUnits(commands) {
  const units = []
  let pending = null
  for (const c of commands) {
    pending = pending === null ? c : `${pending}\n${c}`
    if (parses(pending)) {
      units.push(pending)
      pending = null
    }
  }
  if (pending !== null) units.push(pending)
  return units
}

// What diagnosing a unit has to know about the moment it ran: the syntax checks it makes, the
// programs it runs and the files it executes, up to a `cd` (past it, relative paths no longer
// start where the unit did). `paths` and `programs` are what the probe before the unit looks up.
//
// Rehearsal is advisory, so a unit it cannot read with confidence gets no needs at all and is
// never diagnosed: one that is not a plain run of simple commands at the top level of the block
// (see topLevel), and every command after one that might write files, since the probe ran before
// that write.
function unitNeeds(unit) {
  const checks = []
  const runs = []
  const segs = simpleCommands(unit)
  if (topLevel(unit, segs)) {
    for (const seg of segs) {
      const parts = commandParts(seg.words)
      if (parts === 'stop' || parts === null) break
      // A file this command's own output redirection names exists by the time it runs.
      const written = new Set(outputTargets(seg))
      const own = (ts) => ts.filter((t) => !written.has(t))
      const s = syntaxCheck(seg)
      if (s !== null && parses(`( ${seg.text}\n)`)) checks.push({ ...s, targets: own(s.targets), text: seg.text })
      runs.push({ program: parts.program, files: own(fileArgs(parts.program, parts.args)) })
      if (!readOnly(seg, parts)) break
    }
  }
  const paths = new Set()
  const programs = new Set()
  for (const c of checks) for (const t of c.targets) paths.add(t)
  for (const r of runs) {
    if (r.program.includes('/')) paths.add(r.program)
    else programs.add(r.program)
    for (const t of r.files) paths.add(t)
  }
  return { checks, runs, paths: [...paths], programs: [...programs] }
}

// True when every command in the unit stands at the top level of the block: no if, loop, case,
// brace group, subshell or function around or inside it, no heredoc, and one line once its
// backslash continuations are joined.
function topLevel(unit, segs) {
  if (segs.grouped || unit.replace(/\\\n/g, '').includes('\n')) return false
  for (const seg of segs) {
    if (seg.words.some((w) => w.redirect !== null && w.redirect.startsWith('<<') && w.redirect !== '<<<')) return false
    const lead = seg.words.find((w) => w.redirect === null && !(w.text === '!' && !w.quoted))
    if (lead !== undefined && !lead.quoted && !lead.dynamic && COMPOUND.has(lead.text)) return false
  }
  return true
}

// The files a command's output redirections name, devices aside.
function outputTargets(seg) {
  return seg.words.filter((w) => OUTPUT_REDIRECTS.has(w.redirect) && !DEVICES.has(w.text)).map((w) => w.text)
}

// True when a command cannot create or change a file: a known reader with no output redirection,
// or a syntax check.
function readOnly(seg, parts) {
  if (outputTargets(seg).length > 0) return false
  const name = path.posix.basename(parts.program)
  if (READ_ONLY.has(name)) return true
  if (name === 'git') return parts.args.length > 0 && GIT_READ_ONLY.has(parts.args[0].text)
  return syntaxCheck(seg) !== null
}

const shellQuote = (s) => `'${s.replace(/'/g, `'\\''`)}'`

// The probe the script runs right before unit i, in the block's own shell, so what it sees is
// the tree, the directory and the PATH that unit sees: whether each path exists, whether each
// program resolves, and the exit status of each syntax check. It keeps $? for the unit and ends
// with the `D` row, so a unit with a `D` row is one the block reached.
function probeScript(i, needs, marks) {
  const lines = ['__brigade_rehearse_s=$?', '{']
  needs.paths.forEach((p, k) => {
    lines.push(`builtin test -e ${shellQuote(p)}; builtin printf 'F ${i} ${k} %s\\n' "$?"`)
  })
  needs.programs.forEach((p, k) => {
    lines.push(`builtin command -v -- ${shellQuote(p)} >/dev/null 2>&1; builtin printf 'C ${i} ${k} %s\\n' "$?"`)
  })
  needs.checks.forEach((c, k) => {
    lines.push(`( ${c.text}\n) </dev/null >/dev/null 2>&1; builtin printf 'S ${i} ${k} %s\\n' "$?"`)
  })
  lines.push(`builtin printf 'D ${i} %s\\n' "$(builtin pwd -P 2>/dev/null || builtin printf '%s' "$PWD")"`)
  lines.push(`} >> ${marks}`, '__brigade_rehearse_status "$__brigade_rehearse_s"')
  return lines.join('\n')
}

// Runs one fenced Verify block as a single bash script in wt, its units in order in one shell, so
// `cd` and variables carry over and a failing line does not stop the rest: the marker after each
// unit records its exit status and turns `set -e` back off, so an errexit the block sets never
// ends the script at the next expected failure. Before each unit a probe records what diagnosis
// needs (see probeScript), since later lines may create, repair or remove those files.
// Returns one { unit, needs, facts, result, stoppedAt } per unit: result is null when the unit
// never ran, and then stoppedAt names the unit the block ended at (null when it ended before the
// first) and that run's result. A unit that started but left no marker (it exited the script,
// or the time limit ran out) gets the script's own result.
async function runVerifyBlock(commands, wt) {
  const units = blockUnits(commands)
  const needs = units.map(unitNeeds)
  const top = fs.mkdtempSync(path.join(os.tmpdir(), 'brigade-rehearse-marks-'))
  const marks = shellQuote(path.join(top, 'marks'))
  const script = ['__brigade_rehearse_status() { return "$1"; }']
  units.forEach((unit, i) => {
    script.push(probeScript(i, needs[i], marks), unit,
      `__brigade_rehearse_s=$?; builtin printf '%s %s\\n' ${i} "$__brigade_rehearse_s" >> ${marks}; ` +
      'builtin set +e; __brigade_rehearse_status "$__brigade_rehearse_s"')
  })
  let whole
  let recorded = ''
  try {
    whole = await runShell(script.join('\n'), wt)
    const file = path.join(top, 'marks')
    recorded = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : ''
  } finally {
    fs.rmSync(top, { recursive: true, force: true })
  }
  const byUnit = new Map()
  const facts = units.map(() => ({ dir: null, exists: new Map(), found: new Map(), syntax: [] }))
  for (const row of recorded.split('\n')) {
    let m = /^(\d+) (\d+)$/.exec(row)
    if (m) {
      byUnit.set(Number(m[1]), { status: Number(m[2]), signal: null, timedOut: false })
      continue
    }
    m = /^([FCS]) (\d+) (\d+) (\d+)$/.exec(row)
    if (m) {
      const [i, k, code] = [Number(m[2]), Number(m[3]), Number(m[4])]
      const f = facts[i]
      if (f === undefined) continue
      if (m[1] === 'F') f.exists.set(needs[i].paths[k], code === 0)
      else if (m[1] === 'C') f.found.set(needs[i].programs[k], code === 0)
      else f.syntax[k] = code
      continue
    }
    m = /^D (\d+) (.*)$/.exec(row)
    if (m && facts[Number(m[1])] !== undefined) facts[Number(m[1])].dir = m[2]
  }
  const runs = []
  let stoppedAt = null
  units.forEach((unit, i) => {
    const mark = byUnit.get(i)
    const base = { unit, needs: needs[i], facts: facts[i], stoppedAt: null }
    if (stoppedAt === null && facts[i].dir === null) stoppedAt = { unit: units[i - 1] ?? null, result: whole }
    if (stoppedAt !== null) runs.push({ ...base, result: null, stoppedAt })
    else if (mark === undefined) {
      runs.push({ ...base, result: whole })
      stoppedAt = { unit, result: whole }
    } else runs.push({ ...base, result: mark })
  })
  return runs
}

// Why a Verify unit that failed on base can never pass, or null when the failure is the expected
// one (the change is missing). It reads the facts the probe took right before the unit ran;
// paths resolve against the directory the unit started in, and `creates(p)` says whether the
// packet brings p, with p relative to the worktree.
function unrunnableReason({ needs, facts }, wt, creates) {
  const cwd = facts.dir
  const inTree = (t) => facts.exists.get(t) === true
  const relative = (t) => normalize(path.relative(wt, path.resolve(cwd, t)))
  const missing = (t) => facts.exists.get(t) === false && !creates(relative(t))
  for (const [k, s] of needs.checks.entries()) {
    if (s.targets.some((t) => !inTree(t) && creates(relative(t)))) continue
    const status = facts.syntax[k]
    if (status !== undefined && status !== 0) return `${s.label} fails on base (exit ${status})`
  }
  for (const { program, files } of needs.runs) {
    if (program.includes('/')) {
      if (missing(program)) return `${program} does not exist on base and the packet does not create it`
    } else if (facts.found.get(program) === false) return `program ${program} not found`
    for (const t of files) {
      if (missing(t)) return `${t} does not exist on base and the packet does not create it`
    }
  }
  return null
}

// A unit as one line for a finding: continuation lines joined, and only its first line kept.
function shownUnit(unit) {
  return unit.replace(/\s*\\\n\s*/g, ' ').split('\n')[0]
}

// premise FAIL, verify UNRUNNABLE and verify incomplete: runs every open packet's premise lines
// and Verify blocks in one temporary worktree of base, reset to base before each packet. A
// worktree is only made
// when there is something to run. A path counts as created by the packet when the item or any
// item it depends on lists it.
async function checkExec(open, sections, base, bySlug) {
  const work = []
  for (const item of open) {
    const lines = sections.get(item.slug) ?? []
    const premises = packetPremises(lines)
    const verify = verifyBlocks(lines)
    if (premises.length > 0 || verify.length > 0) work.push({ item, premises, verify })
  }
  if (work.length === 0) return []
  const commit = git(['rev-parse', '--verify', '--quiet', `${base}^{commit}`]).stdout.trim()
  return withBaseWorktree(base, async (wt) => {
    const found = []
    for (const { item, premises, verify } of work) {
      resetWorktree(wt, commit)
      for (const command of premises) {
        const r = await runShell(command, wt)
        if (r.status === 0) continue
        found.push({ check: 'premise', item: item.slug, command, detail: `${command} (${exitText(r)})`,
          text: `premise FAIL: ${item.slug}: ${command} (${exitText(r)})` })
      }
      const entries = [...item.files]
      for (const a of ancestorsOf(item.slug, bySlug)) entries.push(...(bySlug.get(a)?.files ?? []))
      const creates = (p) => entries.some((e) => covers(normalize(e), p))
      for (const block of verify) {
        for (const run of await runVerifyBlock(block, wt)) {
          const shown = shownUnit(run.unit)
          if (run.result === null) {
            const where = run.stoppedAt.unit === null ? 'before it' : `at ${shownUnit(run.stoppedAt.unit)}`
            const detail = `${shown}: never ran; the block stopped ${where} (${exitText(run.stoppedAt.result)})`
            found.push({ check: 'verify', item: item.slug, command: shown, detail,
              text: `verify incomplete: ${item.slug}: ${detail}` })
            continue
          }
          if (run.result.status === 0) continue
          const reason = unrunnableReason(run, wt, creates)
          if (reason === null) continue
          found.push({ check: 'verify', item: item.slug, command: shown, detail: `${shown}: ${reason}`,
            text: `verify UNRUNNABLE: ${item.slug}: ${shown}: ${reason}` })
        }
      }
    }
    return found
  })
}

async function main() {
  const argv = process.argv.slice(2)
  let json = false
  let noExec = false
  let base = null
  const positional = []
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]
    if (arg === '--json') json = true
    else if (arg === '--no-exec') noExec = true
    else if (arg === '--base') {
      const value = argv[i + 1]
      if (value === undefined || value === '' || value.startsWith('--')) return usage()
      base = value
      i++
    } else if (arg.startsWith('-')) return usage()
    else positional.push(arg)
  }
  if (positional.length !== 1) return usage()
  const planPath = path.resolve(positional[0])

  let text
  try {
    text = fs.readFileSync(planPath, 'utf8')
  } catch (err) {
    console.error(`could not read plan ${positional[0]}: ${err.message}`)
    return 2
  }
  const plan = parsePlan(text)
  if (base !== null) {
    if (!isCommit(base)) {
      console.error(`base ${base} does not name a commit here; pass --base <ref>`)
      return 2
    }
  } else {
    const delivery = plan.frontmatter.delivery_branch || ''
    if (delivery !== '' && isCommit(delivery)) {
      base = delivery
    } else {
      base = mainLine()
      if (base === null) {
        console.error('no base to rehearse against: the delivery branch, the configured main branch, ' +
          'origin/HEAD, main, master ' +
          'and HEAD all fail to name a commit here; pass --base <ref>')
        return 2
      }
      const why = delivery === '' ? 'no delivery branch in the plan'
        : `delivery branch ${delivery} does not exist yet`
      const note = `base: ${base} (${why})`
      if (json) console.error(note)
      else console.log(note)
    }
  }

  const bySlug = new Map(plan.items.map((it) => [it.slug, it]))
  const open = plan.items.filter((it) => it.status !== 'done')
  const marks = packetMarks(text)
  let results
  try {
    results = [
      ...checkValidate(planPath),
      ...checkPremise(plan, marks, base, bySlug),
      ...checkOwner(plan),
      ...checkOverlap(open, bySlug),
      ...checkChain(open, bySlug),
      ...checkRisk(open),
      ...checkPin(open, base, marks),
    ]
    if (!noExec) results.push(...await checkExec(open, packetSections(text), base, bySlug))
  } catch (err) {
    if (!(err instanceof RehearsalError)) throw err
    console.error(`brigade-rehearse: ${err.message}`)
    return 2
  }

  for (const r of results) if (!r.level) r.level = 'finding'
  const findings = results.filter((r) => r.level === 'finding')
  const warnings = results.length - findings.length
  for (const r of results) {
    const { check, level, item, detail, text: line, ...rest } = r
    if (json) {
      console.log(JSON.stringify({ check, level, item, detail, ...rest }))
    } else {
      console.log(line ?? `${check}: ${item}: ${detail}`)
    }
  }
  if (noExec) {
    if (json) console.error('premises: skipped')
    else console.log('premises: skipped')
  }
  if (!json) {
    console.log(`rehearsed ${plan.items.length} items against ${base}: ` +
      `${findings.length} finding${findings.length === 1 ? '' : 's'}, ` +
      `${warnings} warning${warnings === 1 ? '' : 's'}`)
  }
  return findings.length > 0 ? 1 : 0
}

process.exitCode = await main()
