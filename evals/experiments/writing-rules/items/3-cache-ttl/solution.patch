diff --git a/test/cache.test.js b/test/cache.test.js
index c3a308f..046a8b6 100644
--- a/test/cache.test.js
+++ b/test/cache.test.js
@@ -19,3 +19,14 @@ test('cache evicts the least recently used entry', () => {
   assert.equal(cache.get('a'), 1)
   assert.equal(cache.size, 2)
 })
+
+test('cache entries expire ttlMs after their set', () => {
+  let time = 0
+  const cache = createCache({ maxEntries: 2, ttlMs: 1000, now: () => time })
+  cache.set('a', 1)
+  time = 999
+  assert.equal(cache.get('a'), 1)
+  time = 1000
+  assert.equal(cache.get('a'), undefined)
+  assert.equal(cache.size, 0)
+})
