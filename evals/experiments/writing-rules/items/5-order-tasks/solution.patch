 })
+
+const { orderTasks } = require('../src/tasks.js')
+
+test('orderTasks sorts a copy by priority, then due date', () => {
+  const tasks = [
+    { id: 't1', title: 'Tidy notes', priority: 'normal', done: false },
+    { id: 't2', title: 'Pay rent', priority: 'high', due: '2026-03-02', done: false },
+    { id: 't3', title: 'Book room', priority: 'normal', due: '2026-03-09', done: false },
+  ]
+  assert.deepEqual(orderTasks(tasks).map((task) => task.id), ['t2', 't3', 't1'])
+  assert.deepEqual(tasks.map((task) => task.id), ['t1', 't2', 't3'])
+})
