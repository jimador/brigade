diff --git a/src/tasks.js b/src/tasks.js
index 392bccf..bdc4eba 100644
--- a/src/tasks.js
+++ b/src/tasks.js
@@ -9,4 +9,20 @@ function openTasks(tasks) {
   return tasks.filter((task) => !task.done)
 }
 
-module.exports = { PRIORITY_RANK, openTasks }
+// Returns a new array of the same tasks, done or not: high priority first, then by
+// due date, earliest first, with undated tasks after the dated ones. Ties keep their
+// input order. The caller's array is copied first because sort() works in place.
+function orderTasks(tasks) {
+  return [...tasks].sort((a, b) => {
+    const byPriority = PRIORITY_RANK[a.priority] - PRIORITY_RANK[b.priority]
+    if (byPriority !== 0) return byPriority
+    if (a.due === undefined || b.due === undefined) {
+      return (a.due === undefined ? 1 : 0) - (b.due === undefined ? 1 : 0)
+    }
+    if (a.due < b.due) return -1
+    if (a.due > b.due) return 1
+    return 0
+  })
+}
+
+module.exports = { PRIORITY_RANK, openTasks, orderTasks }
